\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-math-analysis}[2026/09/11 v1.1 ocots -- analyse, calcul differentiel, EDO]
%
% Notations du calcul differentiel et des equations differentielles.
% Charge par math=analysis.

% ---------------------------------------------------------------------------
% Elements differentiels
\newcommand{\Dif}{{\rm D}}
\newcommand{\dif}{\,{\rm d}}
\newcommand{\partialop}{{\rm \partial}}

% Derivees partielles
\newcommand{\pd}[2]{\dfrac{\partial #1}{\partial #2}}
\newcommand{\pdd}[3]{\dfrac{\partial^2 #1}{\partial #2 \partial #3}}

% Gradient : \grad{f} ou \grad{f}{x}
\DeclareDocumentCommand\grad{ m g }{\IfNoValueTF{#2}{\nabla #1}{\nabla_{#2} #1}}

% ---------------------------------------------------------------------------
% Notations de Landau
\newcommand{\smallo}[1]{o\mathopen{}\left(#1\right)}
\newcommand{\bigO}[1]{O\mathopen{}\left(#1\right)}

% ---------------------------------------------------------------------------
% Topologie
\newcommand{\closure}[1]{\xoverline{#1}}
\newcommand{\ball}{{B}}
\newcommand{\closedball}{\xoverline{B}}

% ---------------------------------------------------------------------------
% Espaces fonctionnels
\newcommand{\quotient}[2]{%
  \ensuremath{#1\hspace{1pt}\! /\!\hspace{1pt}\raisebox{-.0ex}{\ensuremath{\mathcal{#2}}}}}

% ---------------------------------------------------------------------------
% Solutions : notation barre generique
\newcommand{\sol}[1]{\bar{#1}}

% ---------------------------------------------------------------------------
% Commutateur. \Lie{A}{B} note le commutateur de deux matrices
% ([A,B] = AB - BA, cf. edo-linear.tex).
\newcommand{\Lie}[2]{\left[#1, #2\right]}

\endinput
