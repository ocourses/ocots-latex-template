\newcommand{\veps}{\varepsilon}
\newcommand{\vphi}{\varphi}

% ---------------------------------------------------------------------------
% Operateurs
%
% \RedeclareMathOperator redefinit un operateur deja fourni par amsmath
% (\det, \Im, \ker...) sans passer par \@ifdefinable.
\newcommand\RedeclareMathOperator{%
  \@ifstar{\def\ocots@rmo@s{m}\ocots@rmo@redeclare}%
          {\def\ocots@rmo@s{o}\ocots@rmo@redeclare}}
\newcommand\ocots@rmo@redeclare[2]{%
  \begingroup\escapechar\m@ne\xdef\@gtempa{{\string#1}}\endgroup
  \expandafter\@ifundefined\@gtempa
    {\@latex@error{\noexpand#1undefined}\@ehc}\relax
  \expandafter\ocots@rmo@decl\ocots@rmo@s{#1}{#2}}
\newcommand\ocots@rmo@decl[3]{%
  \DeclareRobustCommand{#2}{\qopname\newmcodes@#1{#3}}}
\@onlypreamble\RedeclareMathOperator

