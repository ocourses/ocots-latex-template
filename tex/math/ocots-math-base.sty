\newcommand{\TimeInterval}{\ocots@calSpecialSet{I}{\mathcal{I}}}
\DeclareDocumentCommand\ContinuousLinear{g}{%
  \IfNoValueTF{#1}{\ocots@calSet{L}}{\ocots@calSet{L}^{#1}}}
\newcommand{\Cclass}[1]{\ocots@calSet{C}^{#1}}
\newcommand{\AllMaps}{\ocots@calSpecialSet{F}{\mathcal{F}}}
\newcommand{\MultilinearSpace}{\ocots@calSet{E}}
\newcommand{\Reachable}{\ocots@calSet{A}}
\newcommand{\FlowDomain}{\ocots@calSpecialSet{D}{\mathcal{D}}}
\newcommand{\Differentiable}{\ocots@calSet{D}}
\newcommand{\SolutionSpace}{\ocots@calSet{S}}
\newcommand{\GenericNorm}{\ocots@calSpecialSet{N}{\mathcal{N}}}
\newcommand{\MatrixSpace}{\ocots@calSpecialSet{M}{\mathcal{M}}}
\newcommand{\calset}[1]{\ocots@calSet{#1}}
\newcommand{\indicator}{\mathds{1}}

% ---------------------------------------------------------------------------
% Applications
%   \functiondef{f}{E}{F}{x}{f(x)}
\newcommand{\functiondef}[5]{%
  \begin{array}{rcll}
    #1 \colon & #2 & \longrightarrow & #3 \\
              & #4 & \longmapsto     & #5
  \end{array}}

% ---------------------------------------------------------------------------
% Valeur absolue, norme, produit scalaire
\DeclarePairedDelimiter{\abs}{\lvert}{\rvert}
\DeclarePairedDelimiter{\norm}{\lVert}{\rVert}
\newcommand{\inner}[2]{\left(#1 \,|\, #2\right)}

% Ensemble des ... tels que ...
\newcommand{\setst}[2]{\left\{#1\mathrel{}\middle|\mathrel{}#2\right\}}

% ---------------------------------------------------------------------------
% Intervalles
%
% La convention des intervalles ouverts depend de la langue : ]a,b[ en
% francais, (a,b) en anglais. Elle vient du fichier lang/, ce qui evite de
% dupliquer tout le fichier de macros comme le faisait template-en.
\newcommand{\interval}[4]{%
  \mathopen{#1}#2\mathclose{}\mathpunct{},#3\mathclose{#4}}
\newcommand{\intervalcc}[2]{\interval{[}{#1}{#2}{]}}
\newcommand{\intervaloc}[2]{\interval{\ocots@intervalopenleft}{#1}{#2}{]}}
\newcommand{\intervalco}[2]{\interval{[}{#1}{#2}{\ocots@intervalopenright}}
\newcommand{\intervaloo}[2]{%
  \interval{\ocots@intervalopenleft}{#1}{#2}{\ocots@intervalopenright}}
\newcommand{\intervalint}[2]{\interval{\llbracket}{#1}{#2}{\rrbracket}}

% ---------------------------------------------------------------------------
% Comparaison de matrices
\newcommand{\possemidef}{\succeq 0}
\newcommand{\posdef}{\succ 0}
\newcommand{\negdef}{\prec 0}

% ---------------------------------------------------------------------------
% Lettres grecques d'usage courant
\newcommand{\veps}{\varepsilon}
\newcommand{\vphi}{\varphi}

% ---------------------------------------------------------------------------
% Operateurs
%
% \RedeclareMathOperator redefinit un operateur deja fourni par amsmath
% (\det, \Im, \ker...) sans passer par \@ifdefinable.
\newcommand\RedeclareMathOperator{%
  \@ifstar{\def\ocots@rmo@s{m}\ocots@rmo@redeclare}%
          {\def\ocots@rmo@s{o}\ocots@rmo@redeclare}}
\newcommand\ocots@rmo@redeclare[2]{%
  \begingroup\escapechar\m@ne\xdef\@gtempa{{\string#1}}\endgroup
  \expandafter\@ifundefined\@gtempa
    {\@latex@error{\noexpand#1undefined}\@ehc}\relax
  \expandafter\ocots@rmo@decl\ocots@rmo@s{#1}{#2}}
\newcommand\ocots@rmo@decl[3]{%
  \DeclareRobustCommand{#2}{\qopname\newmcodes@#1{#3}}}
\@onlypreamble\RedeclareMathOperator

