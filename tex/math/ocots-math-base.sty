\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-math-base}[2026/09/11 v1.1 ocots -- macros mathematiques de base]
%
% Notations communes a tous les cours : ensembles de nombres, normes,
% intervalles, operateurs. Toujours charge.
%
% Les modules thematiques (analysis, control, measure) viennent par-dessus, via
% l'option math= : un polycopie de calcul differentiel n'a pas a embarquer les
% notations du controle optimal, contrairement a la v0.
%
% Les noms publics suivent les concepts en anglais ; leur rendu peut suivre la
% langue et les options setfont/calfont du document.

\RequirePackage{xspace}

% ---------------------------------------------------------------------------
% Barre superieure ajustee : remplace \bar sur les symboles larges
\newsavebox\ocots@boxA
\newsavebox\ocots@boxB
\newlength\ocots@lenA
\newcommand*\xoverline[2][0.75]{%
  \sbox{\ocots@boxA}{$\m@th#2$}%
  \setbox\ocots@boxB\null
  \ht\ocots@boxB=\ht\ocots@boxA
  \dp\ocots@boxB=\dp\ocots@boxA
  \wd\ocots@boxB=#1\wd\ocots@boxA
  \sbox\ocots@boxB{$\m@th\overline{\copy\ocots@boxB}$}%
  \setlength\ocots@lenA{\the\wd\ocots@boxA}%
  \addtolength\ocots@lenA{-\the\wd\ocots@boxB}%
  \ifdim\wd\ocots@boxB<\wd\ocots@boxA
    \rlap{\hskip 0.5\ocots@lenA\usebox\ocots@boxB}{\usebox\ocots@boxA}%
  \else
    \hskip -0.5\ocots@lenA\rlap{\usebox\ocots@boxA}{\hskip 0.5\ocots@lenA\usebox\ocots@boxB}%
  \fi}

% ---------------------------------------------------------------------------
% Ensembles de nombres
\ifnum\pdfstrcmp{\ocots@setfont}{rm}=\z@
  \newcommand{\nbSet}[1]{\mathrm{#1}}
\else
  \newcommand{\nbSet}[1]{\mathbb{#1}}
\fi
\newcommand{\ocots@calSet}[1]{%
  \ifnum\pdfstrcmp{\ocots@calfont}{cal}=\z@\mathcal{#1}\else\mathscr{#1}\fi}
\newcommand{\ocots@calSpecialSet}[2]{%
  \ifnum\pdfstrcmp{\ocots@calfont}{cal}=\z@
    \mathcal{#1}%
  \else
    \ifnum\pdfstrcmp{\ocots@calfont}{scr}=\z@
      \mathscr{#1}%
    \else
      #2%
    \fi
  \fi}

\newcommand{\N}{\nbSet{N}}
\newcommand{\Z}{\nbSet{Z}}
\newcommand{\Q}{\nbSet{Q}}
\newcommand{\R}{\nbSet{R}}
\newcommand{\C}{\nbSet{C}}
\newcommand{\K}{\nbSet{K}}
\newcommand{\Sphere}{\nbSet{S}}

\newcommand{\ocots@setDeco}[2]{%
  \ifnum\pdfstrcmp{#2}{bar}=\z@
    \xoverline{\nbSet{#1}}%
  \else\ifnum\pdfstrcmp{#2}{star}=\z@
    \nbSet{#1}^{\text{*}}%
  \else\ifnum\pdfstrcmp{#2}{barstar}=\z@
    \xoverline{\nbSet{#1}}^{\text{*}}%
  \else\ifnum\pdfstrcmp{#2}{nonneg}=\z@
    \nbSet{#1}^{\phantom{\text{*}}}_{+}%
  \else\ifnum\pdfstrcmp{#2}{nonpos}=\z@
    \nbSet{#1}^{\phantom{\text{*}}}_{-}%
  \else\ifnum\pdfstrcmp{#2}{neg}=\z@
    \nbSet{#1}^{\text{*}}_{-}%
  \else\ifnum\pdfstrcmp{#2}{pos}=\z@
    \nbSet{#1}^{\text{*}}_{+}%
  \else\ifnum\pdfstrcmp{#2}{barnonneg}=\z@
    \xoverline{\nbSet{#1}}_{+}%
  \fi\fi\fi\fi\fi\fi\fi\fi}

\newcommand{\Nbar}{\ensuremath{\ocots@setDeco{N}{bar}}}
\newcommand{\Nstar}{\ensuremath{\ocots@setDeco{N}{star}}}
\newcommand{\Nbarstar}{\ensuremath{\ocots@setDeco{N}{barstar}}}
\newcommand{\Rnonneg}{\ensuremath{\ocots@setDeco{R}{nonneg}}}
\newcommand{\Rnonpos}{\ensuremath{\ocots@setDeco{R}{nonpos}}}
\newcommand{\Rneg}{\ensuremath{\ocots@setDeco{R}{neg}}}
\newcommand{\Rpos}{\ensuremath{\ocots@setDeco{R}{pos}}}
\newcommand{\Rstar}{\ensuremath{\ocots@setDeco{R}{star}}}
\newcommand{\Rbar}{\ensuremath{\ocots@setDeco{R}{bar}}}
\newcommand{\Rbarnonneg}{\ensuremath{\ocots@setDeco{R}{barnonneg}}}

