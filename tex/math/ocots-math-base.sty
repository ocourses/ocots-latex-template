% Applications
%   \fonction{f}{E}{F}{x}{f(x)}
\newcommand{\fonction}[5]{%
  \begin{array}{rcll}
    #1 \colon & #2 & \longrightarrow & #3 \\
              & #4 & \longmapsto     & #5
  \end{array}}

% ---------------------------------------------------------------------------
% Valeur absolue, norme, produit scalaire
\newcommand{\abs}[1]{\lvert#1\rvert}
\newcommand{\absStyle}[1]{\left\lvert#1\right\rvert}
\newcommand{\norm}[1]{\lVert#1\rVert}
\newcommand{\normStyle}[1]{\left\lVert#1\right\rVert}
\newcommand{\prodscal}[2]{\left(#1 \,|\, #2\right)}

% Ensemble des ... tels que ...
\newcommand{\enstq}[2]{\left\{#1\mathrel{}\middle|\mathrel{}#2\right\}}

% ---------------------------------------------------------------------------
% Intervalles
%
% La convention des intervalles ouverts depend de la langue : ]a,b[ en
% francais, (a,b) en anglais. Elle vient du fichier lang/, ce qui evite de
% dupliquer tout le fichier de macros comme le faisait template-en.
\newcommand{\intervalle}[4]{%
  \mathopen{#1}#2\mathclose{}\mathpunct{},#3\mathclose{#4}}
\newcommand{\intervalleff}[2]{\intervalle{[}{#1}{#2}{]}}
\newcommand{\intervalleof}[2]{\intervalle{\ocots@intervalopenleft}{#1}{#2}{]}}
\newcommand{\intervallefo}[2]{\intervalle{[}{#1}{#2}{\ocots@intervalopenright}}
\newcommand{\intervalleoo}[2]{%
  \intervalle{\ocots@intervalopenleft}{#1}{#2}{\ocots@intervalopenright}}
\newcommand{\intervalleentier}[2]{\intervalle{\llbracket}{#1}{#2}{\rrbracket}}

% ---------------------------------------------------------------------------
