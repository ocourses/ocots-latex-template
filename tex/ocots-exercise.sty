\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-exercise}[2026/10/05 v1.1 ocots -- exercices et corriges]
%
% Un seul mecanisme d'exercice, avec un interrupteur qui marche.
%
%   \begin{exercise}[label=matrices, points=4]
%     Calculer $e^{tA}$ pour ...
%   \solution
%     ...
%   \end{exercise}
%
% L'option `solutions' du paquet ocots decide du sort du corrige :
%
%   none    le corrige n'est pas compose du tout  -> la version etudiante
%   inline  le corrige suit immediatement l'enonce
%   end     le corrige est reporte en fin de partie, avec renvois croises
%
% La v0 avait trois mecanismes concurrents (versions + \ifCORR, mycorr, et
% myexercisecb), et le seul reellement utilise — myexercisecb, 50 emplois —
% etait justement le seul sans interrupteur : sortir un polycopie sans corriges
% imposait d'editer main.tex (defaut D4).
%
% Les corriges reportes sont ecrits a plat dans le repertoire de sortie, et non
% dans un sous-repertoire `solutions/'. Le lien symbolique
% `build/solutions -> ../solutions' que le .latexmkrc de la v0 devait creer
% n'a plus lieu d'etre.

% ---------------------------------------------------------------------------
% Support
% Le support est connu avant le chargement de ce paquet (la classe le definit).
% Les examens et les TD utilisent le rendu sobre des exercices : numerotation
% autonome, sans boite, avec le marqueur d'exercice. Le polycopie et les
% diapositives conservent la boite et le style du theme.
\def\ocots@exam@carrier{exam}
\def\ocots@td@carrier{td}
\newif\ifocots@exam
\ifx\ocots@carrier\ocots@exam@carrier
  \ocots@examtrue
\else\ifx\ocots@carrier\ocots@td@carrier
  \ocots@examtrue
\else
  \ocots@examfalse
\fi\fi

% ---------------------------------------------------------------------------
% Questions et sous-questions
% Questions et sous-questions se citent par \label/\ref : \refstepcounter, et
% un \ref rend le numero tel qu'il est affiche -- « 2.2 » en TD et en examen
% (prefixe du numero d'exercice, \p@question), « 2 » dans le polycopie et les
% diapositives, ou la question se lit dans son exercice. Le compteur de
% question repart a zero a chaque exercice : les ancres hyperref (\theH...)
% portent donc la section et l'exercice pour rester uniques.
\newcounter{question}
\newcounter{subquestion}[question]
\ifocots@exam
  \def\p@question{\theocots@exinner.}
\else
  \def\p@question{}
\fi
\def\p@subquestion{\p@question\thequestion.}
\def\theHquestion{\theHsection.\theocots@exinner.\arabic{question}}
\def\theHsubquestion{\theHquestion.\arabic{subquestion}}

% ---------------------------------------------------------------------------
% Espace de reponse
%
% Dans un sujet ou l'etudiant repond sur la feuille, chaque question laisse
% sous elle la place d'ecrire. Cette place n'a de sens que dans le sujet
% distribue (solutions=none) : des que les corriges sont composes (inline,
% end), le document n'est plus celui que l'etudiant remplit, et aucun espace
% n'est pose -- qu'il y ait une correction ou non.
%
%   \setanswerspace{3cm}             valeur par defaut des questions qui suivent
%   \setanswerspace{0pt}             ... et on l'arrete (defaut : 0, aucun espace)
%   \begin{exercise}[answerspace=4cm]  valeur par defaut dans cet exercice
%   \begin{question}[space=6cm]      valeur propre a une question
%   \begin{subquestion}[space=2cm]   une sous-question n'a d'espace qu'explicite
%   \answerspace[5cm]                espace isole, hors question
%
% Priorite : space= de la question, puis answerspace= de l'exercice, puis
% \setanswerspace. La valeur par defaut ne vaut que pour `question' : une
% question decoupee en sous-questions aurait sinon un blanc entre son enonce
% et ses sous-questions.
%
% L'espace est une boite vide, pas un \vspace : un \vspace tombe a la coupure
% de page et disparait, la boite garantit la place. Le \nobreak la lie a la
% fin de l'enonce, pour que la question ne soit pas separee de sa place.
% L'option ne se lit que collee a \begin{question} (argument `!O' de
% xparse) : un enonce qui commence par un crochet, a la ligne, reste du texte.
% \setanswerspace est global : une partie n'est pas un groupe, et la valeur
% doit traverser les exercices qui la composent.
\def\ocots@sol@none{none}
\def\ocots@as@default{0pt}
\def\ocots@as@exercise{}
\newcommand{\setanswerspace}[1]{\xdef\ocots@as@default{#1}}
\tcbset{answerspace/.code={\def\ocots@as@exercise{#1}}}
\pgfqkeys{/ocots/question}{space/.store in=\ocots@as@local}
\ifx\ocots@solutions\ocots@sol@none
  \newcommand{\ocots@as@put}[1]{%
    \ifdim\dimexpr#1\relax>\z@
      \par\nobreak\vbox to\dimexpr#1\relax{}\par
    \fi}
\else
  \newcommand{\ocots@as@put}[1]{}
\fi
% Valeur en vigueur hors space= : celle de l'exercice, sinon celle du document.
\newcommand{\ocots@as@current}{%
  \ifx\ocots@as@exercise\@empty\ocots@as@default\else\ocots@as@exercise\fi}
\newcommand{\answerspace}[1][\ocots@as@current]{\ocots@as@put{#1}}

\NewDocumentEnvironment{question}{!O{}}
  {\def\ocots@as@local{\ocots@as@current}\pgfqkeys{/ocots/question}{#1}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax\trivlist
   \refstepcounter{question}%
   \ifocots@exam
     \item[\bfseries\hspace{0.5em}\hskip\labelsep
           \theocots@exinner.\thequestion\@addpunct{.}]\ignorespaces
   \else
     \item[\bfseries\hspace{0.5em}\hskip\labelsep
           \thequestion\@addpunct{.}]\ignorespaces
   \fi}
  {\ocots@as@put{\ocots@as@local}\endtrivlist}

\NewDocumentEnvironment{subquestion}{!O{}}
  {\def\ocots@as@local{0pt}\pgfqkeys{/ocots/question}{#1}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax\trivlist
   \refstepcounter{subquestion}%
   \ifocots@exam
     \item[\bfseries\hspace{1.5em}\hskip\labelsep
           \theocots@exinner.\thequestion.\thesubquestion\@addpunct{.}]\ignorespaces
   \else
     \item[\bfseries\hspace{1.5em}\hskip\labelsep
           \thequestion\@addpunct{.}\thesubquestion\@addpunct{.}]\ignorespaces
   \fi}
  {\ocots@as@put{\ocots@as@local}\endtrivlist}

% Force le passage a la question suivante (utile dans un corrige redige a part).
\newcommand{\newquestion}{\stepcounter{question}}

% Utile avant une liste, quand l'enonce n'a pas de texte d'introduction.
\newcommand{\exercisenotext}{~\\ \vspace{-\baselineskip}}

% ---------------------------------------------------------------------------
% Clefs propres aux exercices
\tcbset{points/.store in=\ocots@ex@points, points={}}

% Bareme affiche entre parentheses apres le numero, s'il est renseigne.
\DeclareRobustCommand{\ocots@ex@pointstext}{%
  \ifx\ocots@ex@points\@empty\else~(\ocots@ex@points~\ocotsstring{points})\fi}

% ---------------------------------------------------------------------------
% Compteurs de numerotation
%
% Deux compteurs : l'un pour l'affichage, l'autre pour les references. C'est le
% montage de la v0, conserve tel quel — il permet a \ref de pointer l'exercice
% et non la boite.
\newcounter{ocots@partpoints}
\newcounter{ocots@totalpoints}
\newif\ifocots@partactive
\ocots@partactivefalse
\newcommand{\ocots@startpart}{%
  \ifocots@partactive
    \ocots@endpart{\theocots@docpart}%
  \fi
  \setcounter{ocots@partpoints}{0}%
  \global\ocots@partactivetrue}
\newcommand{\ocots@endpart}[1]{%
  \ifnum\value{ocots@partpoints}>0
    \par\medskip
    \noindent\textit{\ocotsstring{part}~#1~:~\ocotsstring{graded-out-of}~%
      \arabic{ocots@partpoints}~\ocotsstring{points}}%
  \fi}
\AtEndDocument{%
  \ifocots@partactive
    \ocots@endpart{\theocots@docpart}%
  \fi
  \ifnum\value{ocots@totalpoints}>0
    \par\medskip
    \noindent\textit{\ocotsstring{total}~:~\ocotsstring{graded-out-of}~%
      \arabic{ocots@totalpoints}~\ocotsstring{points}}%
  \fi}
\newcounter{ocots@exinner}[section]
\newcounter{ocots@exouter}[section]
\ifocots@exam
  \renewcommand{\theocots@exinner}{\theocots@exouter}
  \def\ocots@ex@counter{auto counter}
\else
  \renewcommand{\theocots@exinner}{\thesection.\theocots@exouter}
  \def\ocots@ex@counter{auto counter, number within=section}
\fi
% Robuste, comme tout ce qui apparait dans une liste de clefs tcolorbox :
% pgfkeys developpe la liste au moment de l'analyse, et un \stepcounter
% developpe trop tot casse la construction de son \csname.
\DeclareRobustCommand{\ocots@exstep}{%
  \stepcounter{ocots@exouter}\refstepcounter{ocots@exinner}%
  \setcounter{question}{0}%
  % Le bareme (total de partie, total de sujet) n'a de sens que pour un
  % document note - TD ou examen. Ailleurs (polycopie, diapositives),
  % points= ne sert qu'a l'affichage local "(N points)" ci-dessus : ne pas
  % alimenter ocots@totalpoints/ocots@partpoints y evite un "Total : note
  % sur N points" surprenant en fin de document (cf. issue #22).
  \ifocots@exam
    \ifx\ocots@ex@points\@empty\else
      \global\advance\c@ocots@totalpoints by \ocots@ex@points\relax
      \global\advance\c@ocots@partpoints by \ocots@ex@points\relax
    \fi
  \fi}

% ---------------------------------------------------------------------------
% La boite d'exercice, declinee selon le mode
%
% Le corps est le meme dans les trois cas ; seuls changent le titre et le sort
% de la partie basse. On ecrit donc la forme commune une fois.
% Un fragment de liste de clefs doit etre un *style* pgfkeys, pas une macro :
% pgfkeys decoupe la liste sur les virgules avant de developper, si bien qu'une
% macro contenant des virgules est prise pour une clef unique.
\ifocots@exam
  \def\ocots@ex@mark{$\rhd$\hspace{1ex}}
  \tcbset{ocots@ex@base/.style={%
    enhanced jigsaw, blanker, breakable, lower separated=false,
    left=0pt, right=0pt, top=2mm, bottom=2mm,
    attach title to upper=~,
    fonttitle=\bfseries\upshape,
    coltitle=black}}
\else
  \def\ocots@ex@mark{}
  \tcbset{ocots@ex@base/.style={%
    \ocotsboxstyle{exercise}, breakable, lower separated=false,
    attach title to upper=~}}
\fi
% L'habillage (ocots@ex@base) est separe de l'increment du compteur : la
% variante etoilee exercise* reprend le premier sans le second.
\tcbset{ocots@ex@common/.style={ocots@ex@base, before title={\ocots@exstep}}}

\def\ocots@sol@inline{inline}
\ifx\ocots@solutions\ocots@sol@none
  % ----- solutions=none : la partie basse est ignoree, rien n'est ecrit.
  \expandafter\NewTColorBox\expandafter[\ocots@ex@counter]{exercise}{ O{} }{%
    ocots@ex@common,
    title={\ocots@ex@mark\ocotsstring{exercise}~\thetcbcounter\ocots@ex@pointstext~:},
    lowerbox=ignored, #1}
\else\ifx\ocots@solutions\ocots@sol@inline
  % ----- solutions=inline : la partie basse suit l'enonce.
  \expandafter\NewTColorBox\expandafter[\ocots@ex@counter]{exercise}{ O{} }{%
    ocots@ex@common,
    title={\ocots@ex@mark\ocotsstring{exercise}~\thetcbcounter\ocots@ex@pointstext~:},
    #1}
\else
  % ----- solutions=end : la partie basse est enregistree et rejouee plus loin.
  \expandafter\NewTColorBox\expandafter[\ocots@ex@counter]{exercise}{ O{} }{%
    ocots@ex@common,
    title={\ocots@ex@mark\ocotsstring{exercise}~\thetcbcounter\ocots@ex@pointstext~%
           (\ocotsstring{solution-at}~\ocotsstring{page-abbr}~%
            \pageref{ocots@sol@\thetcbcounter})~:},
    label={ocots@ex@\thetcbcounter},
    lowerbox=ignored,
    savelowerto={ocots-solution-\thetcbcounter.tex},
    record={\string\ocotssolutionbox{\thetcbcounter}%
            {ocots-solution-\thetcbcounter.tex}},
    #1}

  \NewTotalTColorBox{\ocotssolutionbox}{mm}{%
    \ocotsboxstyle{solution}, breakable,
    title={\ocotsstring{solution-of}~\ref{ocots@ex@#1}~%
           \ocotsstring{page-abbr}~\pageref{ocots@ex@#1}~:},
    phantomlabel={ocots@sol@#1},
    attach title to upper=~}{\input{#2}}
\fi\fi

% ---------------------------------------------------------------------------
% Exercice non numerote
%
%   \begin{exercise*}[points=2]
%     ...
%   \solution
%     ...
%   \end{exercise*}
%
% Meme habillage que exercise, mais aucun compteur n'est incremente : la
% numerotation des exercices numerotes qui suivent reste celle du polycopie,
% ce qui permet a des diapositives de n'en reprendre qu'une partie. Sans
% numero, le corrige ne peut pas etre reporte en fin de partie (il n'aurait
% rien pour y renvoyer) : il n'est compose qu'en mode `inline', et ignore
% dans les deux autres.
\ifx\ocots@solutions\ocots@sol@inline
  \tcbset{ocots@ex@starlower/.style={}}
\else
  \tcbset{ocots@ex@starlower/.style={lowerbox=ignored}}
\fi
\NewTColorBox{exercise*}{ O{} }{%
  ocots@ex@base,
  before title={\setcounter{question}{0}},
  title={\ocots@ex@mark\ocotsstring{exercise}\ocots@ex@pointstext~:},
  ocots@ex@starlower, #1}

% Debut du corrige. En mode `none' ce qui suit est ignore par tcolorbox.
%
% C'est une commande et non un environnement, a dessein : \begin{solution}
% ouvrirait un groupe, et la separation haute/basse d'une tcolorbox doit se
% faire au premier niveau. Un \tcblower pris dans un groupe est perdu a sa
% fermeture, et la boite part en « File ended while scanning use of \next ».
\ocotsfreeenv{solution}
\newcommand{\solution}{\tcblower}

% Correction breve, hors boite d'exercice : sert dans les TD et les sujets
% d'examen, ou l'enonce n'est pas encadre.
%
% Le marqueur est l'etiquette d'une trivlist, comme celui de `proof' : une
% liste qui ouvre la correction commence ainsi sur la ligne du marqueur, au
% lieu de le laisser seul au-dessus d'elle (ocots-latex-template#54).
%   - \topsep et \partopsep sont nuls le temps d'ouvrir la trivlist, pour
%     garder l'espacement d'un simple paragraphe, puis retablis : une liste
%     interieure doit retrouver le sien ;
%   - la trivlist encadre l'etiquette de -\labelsep et +\labelsep : on les
%     neutralise, le marqueur occupe exactement sa largeur ;
%   - l'espace qui suit le marqueur est pose hors de l'etiquette, pour rester
%     etirable comme avant dans une correction qui commence par du texte. Il
%     est omis devant un \begin, sans quoi il ouvrirait le paragraphe et la
%     liste repartirait a la ligne ;
%   - devant un \begin, le marqueur est de largeur nulle : la premiere puce
%     reste alignee sur les suivantes au lieu d'etre repoussee par lui ;
%   - une liste ouverte sur l'etiquette est marquee @noparlist par LaTeX, qui
%     omet alors l'espace apres elle : le texte qui la suit dans la correction
%     s'y collerait. \ocots@corr@list leve ce drapeau pour cette seule liste.
\newenvironment{correction}
  {\par\color{\ocotscolor{emph-a}}%
   \edef\ocots@corr@skips{\topsep\the\topsep\relax\partopsep\the\partopsep\relax}%
   \topsep\z@skip\partopsep\z@skip
   \trivlist\ocots@corr@skips
   \@ifnextchar\begin
     {\item[\hskip\labelsep\rlap{$\RHD$}\hskip-\labelsep]\ocots@corr@list}
     {\item[\hskip\labelsep$\RHD$\hskip-\labelsep]~}}
  {\endtrivlist\@endpefalse}
\def\ocots@corr@list{%
  \let\ocots@corr@trivlist\@trivlist
  \def\@trivlist{\global\let\@trivlist\ocots@corr@trivlist
    \ocots@corr@trivlist\@noparlistfalse}}
% \excludeversion redefinit l'environnement : on le libere d'abord, sans quoi
% versions avertit « Redefining environment `correction' ».
\ifx\ocots@solutions\ocots@sol@none
  \let\correction\relax\let\endcorrection\relax
  \excludeversion{correction}
\fi

% Exercice sans corrige, quel que soit le mode :
%   \begin{exercise}[nosolution]
\tcbset{nosolution/.style={%
  no recording, lowerbox=ignored,
  title={\ocots@ex@mark\ocotsstring{exercise}~\thetcbcounter\ocots@ex@pointstext~:}}}

% ---------------------------------------------------------------------------
% Pilotage depuis le document
%
%   \ocotscollectsolutions      au debut d'une partie
%   \ocotsprintsolutions        la ou les corriges doivent apparaitre
%
% En mode `none' et `inline', ce sont des instructions vides : le document ne
% change pas d'une version a l'autre, seule l'option bouge.
\ifx\ocots@solutions\ocots@sol@none
  \newcommand{\ocotscollectsolutions}{}
  \newcommand{\ocotsprintsolutions}{}
\else\ifx\ocots@solutions\ocots@sol@inline
  \newcommand{\ocotscollectsolutions}{}
  \newcommand{\ocotsprintsolutions}{}
\else
  \newcommand{\ocotscollectsolutions}{\tcbstartrecording}
  \newcommand{\ocotsprintsolutions}{\tcbstoprecording\tcbinputrecords}
\fi\fi

\endinput
