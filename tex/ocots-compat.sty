% ---------------------------------------------------------------------------
% Macros mathematiques renommees par le chantier 2.
% Les alias restent ici pour permettre une migration progressive des cours.
\newif\ifocots@deprecatedmathwarned
\ocots@deprecatedmathwarnedfalse
\newcommand{\ocots@deprecatedmath}[2]{%
  \ifocots@deprecatedmathwarned\else
    \PackageWarningNoLine{ocots}{Deprecated mathematical macro used; migrate to the new notation}%
    \global\ocots@deprecatedmathwarnedtrue
  \fi
}

