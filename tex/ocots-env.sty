\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-env}[2026/09/03 v1.0 ocots -- environnements]
%
% L'API publique du template : theoremes, definitions, exemples, remarques,
% preuves, hypotheses.
%
% REGLE CENTRALE DE LA REFONTE
% Ces environnements sont definis UNE SEULE FOIS, quel que soit le support.
% Aucun \ifSLIDES, aucun test de theme : la forme vient de \ocotsboxstyle, les
% couleurs du registre, les intitules de \ocotsstring. C'est ce qui permet de
% coller un enonce de TD dans le polycopie sans le retoucher — impossible en
% v0, ou les memes noms avaient deux signatures incompatibles (defaut D2).
%
% Les retouches propres a un medium (remise a zero des compteurs entre les
% \pause de beamer, par exemple) sont enregistrees par carrier/, apres coup.

% ---------------------------------------------------------------------------
% Liberation des noms
%
% beamer definit deja theorem, definition, corollary, lemma, example, proof...
% On les remplace deliberement par les notres, identiques d'un support a
% l'autre. C'est ce que la v0 contournait en prefixant tout par « my ».
\ocotsfreeenvs{theorem,definition,proposition,corollary,conjecture,lemma,%
example,remark,proof,assumption,hypothesis,citedtheorem,solution,exercise,%
question,fact,problem,corollaire,theoreme,definitions,examples,%
theorem*,definition*,proposition*,corollary*,conjecture*,citedtheorem*}

% ---------------------------------------------------------------------------
% Marqueurs de preuve
\newcommand{\newstep}{\textasteriskcentered}
\newcommand*{\QEDA}{\hfill\ensuremath{\blacksquare}}
\newcommand*{\QEDB}{\hfill\ensuremath{\square}}

% ---------------------------------------------------------------------------
% Signature commune : titre, etiquette et note sont des clefs optionnelles.
%
% Trois compteurs, tous remis a zero a chaque section :
%   - `theorem'  : les RESULTATS (theoreme, definition, proposition, corollaire,
%                  conjecture, lemme, theoreme cite), qui le partagent ;
%   - `example'  : les exemples ;
%   - `remark'   : les remarques.
% Les exercices ont deja le leur (ocots-exercise.sty).
%
% Pourquoi separer : des diapositives reprennent un polycopie et doivent
% numeroter ses resultats a l'identique, mais n'en reprennent pas tous les
% exemples ni toutes les remarques. Avec un compteur unique, chaque exemple
% omis decalait tous les resultats qui suivent (Definition, Remarque,
% Proposition devenait Definition, Proposition avec un numero de moins). Avec
% des compteurs separes, les resultats ne dependent plus que des resultats ;
% un exemple ou une remarque repris sans les autres se met en variante etoilee.
%
% On n'utilise pas \newtcbtheorem ici : son dernier argument impose un prefixe
% de label et rend impossible une etiquette brute (par exemple `thm:cauchy').
% beamer cree deja `theorem' ; `example' et `remark' sont gardes de meme.
\@ifundefined{c@theorem}{\newcounter{theorem}[section]}{\@addtoreset{theorem}{section}}
\renewcommand{\thetheorem}{\thesection.\arabic{theorem}}
\@ifundefined{c@example}{\newcounter{example}[section]}{\@addtoreset{example}{section}}
\renewcommand{\theexample}{\thesection.\arabic{example}}
\@ifundefined{c@remark}{\newcounter{remark}[section]}{\@addtoreset{remark}{section}}
\renewcommand{\theremark}{\thesection.\arabic{remark}}

\pgfkeys{/ocots/result/.is family,
  /ocots/result,
  title/.store in=\ocots@result@title,
  label/.store in=\ocots@result@label,
  note/.store in=\ocots@result@note}

\newcommand{\ocots@result@reset}{%
  \def\ocots@result@title{}%
  \def\ocots@result@label{}%
  \def\ocots@result@note{}}

% Lit l'argument optionnel commun : soit une liste `cle=valeur' (des qu'un `='
% apparait), soit un titre brut. Ce filet est ce qui permet a l'ancienne
% syntaxe a un seul argument (`\begin{example}[Titre]', ou encore
% `\begin{remark*}[Contre-exemple]', toujours presente dans le corpus, cf.
% td/td3/td3.tex) de continuer a fonctionner : sans lui, un titre brut sans
% `=' tombe dans pgfkeys et casse la compilation (« I do not know the key »).
%
% La detection du `=' NE DOIT PAS passer par \IfSubStr (xstring) : xstring
% force l'expansion complete de #1 pour le scruter, et plante des qu'un titre
% contient une macro non trivialement expansible (\R, \mathbb{R}, \iere de
% babel-french...), y compris standard — cf. issue #18. \tl_if_in:nnTF est un
% test « n » (non-expansible) de l3tl : il compare les tokens de #1 sans
% jamais les developper, donc sans jamais executer les macros du titre. Cout
% nul en dependances : xparse (deja charge, cf. ocots-packages.sty) tire
% expl3.
\ExplSyntaxOn
\newcommand{\ocots@result@parseopt}[1]{%
  \ocots@result@reset
  \IfBlankTF{#1}{}{%
    \tl_if_in:nnTF{#1}{=}{\pgfkeys{/ocots/result,#1}}{\def\ocots@result@title{#1}}}}
\ExplSyntaxOff

% Increment du compteur partage, et type de renvoi cleveref.
%
% Les cinq familles de boites partagent le compteur `theorem' (ci-dessus), ce
% qui est voulu : un numero ne designe qu'un seul objet. Mais cleveref lit le
% TYPE d'une etiquette dans le nom du compteur incremente -- il rendait donc
% \cref{def:x} par « Theoreme 2.7 » sur une definition. Les lemmes y
% echappaient : ils passent par \newtheorem{ocots@lemma}[theorem], qui laisse
% \@currentcounter au nom d'ENVIRONNEMENT et non a celui du compteur.
%
% cleveref dissocie les deux par \refstepcounter[<type>]{<compteur>} ; #2 est
% deja le nom de la famille (« definition », « corollary »...). Cela ne suffit
% pas seul : depuis LaTeX 2023, le noyau charge
% latex2e-first-aid-for-external-files.ltx, qui greffe sur le crochet `label'
% un correctif cleveref recalculant le type a partir de \@currentcounter --
% donc du compteur -- et ecrasant celui qu'on vient de poser. Ce recalcul se
% saute quand \@currentcounter est vide : on le vide donc juste apres.
% L'affectation est locale au groupe d'environnement.
%
% Sans cleveref, \refstepcounter n'a pas d'argument optionnel. Les deux
% variantes sont donc definies ici, la nue servant de defaut, et le crochet de
% \begin{document} ne fait que basculer de l'une a l'autre si le paquet est la.
% Basculer plutot que \renewcommand sur place : un \renewcommand a parametre
% ecrit DANS \AtBeginDocument passe par un \xdef qui bute sur le #
% (« Illegal parameter number »).
\newcommand{\ocots@result@refstep@plain}[1]{\refstepcounter{theorem}}
\newcommand{\ocots@result@refstep@cref}[1]{%
  \refstepcounter[#1]{theorem}\def\@currentcounter{}}
\newcommand{\ocots@result@refstep}{\ocots@result@refstep@plain}

\newcommand{\ocots@result@beginbox}[6]{%
  \ocots@result@parseopt{#3}%
  \IfNoValueF{#4}{\def\ocots@result@title{#4}}
  % L'ancienne forme {titre}{etiquette} attend une etiquette SANS le prefixe
  % (que ce mecanisme ajoute) ; mais rien n'empeche un auteur de le taper quand
  % meme par habitude, ce qui donnait `thm:thm:cauchy' (defaut d'origine de ce
  % chantier). Idempotence : si le prefixe y est deja, on ne le rajoute pas.
  \IfNoValueF{#5}{\IfBlankTF{#5}{}{%
    \IfBeginWith{#5}{#6}
      {\def\ocots@result@label{#5}}%
      {\def\ocots@result@label{#6#5}}}}
  \ocots@result@refstep{#2}%
  \begin{tcolorbox}[
    \ocotsboxstyle{#2}, breakable,
    title={#1~\thetheorem%
      \ifx\ocots@result@title\@empty\else~\ocots@result@title\fi
      \ifx\ocots@result@note\@empty\else~(\ocots@result@note)\fi}]%
  \ifx\ocots@result@label\@empty\else
    \label{\ocots@result@label}%
  \fi}
\newcommand{\ocots@result@endbox}{\end{tcolorbox}}

% Variante etoilee des boites : meme habillage, meme titre et meme note, mais
% ni numero ni increment du compteur -- c'est tout son interet, puisqu'elle
% laisse intacte la numerotation des boites numerotees qui suivent. Une
% etiquette n'aurait rien a designer : on l'ignore, avec un avertissement.
\newcommand{\ocots@result@beginbox@star}[6]{%
  \ocots@result@parseopt{#3}%
  \IfNoValueF{#4}{\def\ocots@result@title{#4}}%
  \IfNoValueF{#5}{\IfBlankTF{#5}{}{\def\ocots@result@label{#5}}}%
  \ifx\ocots@result@label\@empty\else
    \PackageWarning{ocots}{Label `\ocots@result@label' ignored on unnumbered
      environment `#2*'}%
  \fi
  \begin{tcolorbox}[
    \ocotsboxstyle{#2}, breakable,
    title={#1%
      \ifx\ocots@result@title\@empty\else~\ocots@result@title\fi
      \ifx\ocots@result@note\@empty\else~(\ocots@result@note)\fi}]}

\NewDocumentEnvironment{theorem}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{theorem}}{theorem}{#1}{#2}{#3}{thm:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{definition}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{definition}}{definition}{#1}{#2}{#3}{def:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{proposition}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{proposition}}{proposition}{#1}{#2}{#3}{prop:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{corollary}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{corollary}}{corollary}{#1}{#2}{#3}{cor:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{conjecture}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{conjecture}}{conjecture}{#1}{#2}{#3}{conj:}}
  {\ocots@result@endbox}

\NewDocumentEnvironment{theorem*}{O{} g g}
  {\ocots@result@beginbox@star{\ocotsstring{theorem}}{theorem}{#1}{#2}{#3}{thm:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{definition*}{O{} g g}
  {\ocots@result@beginbox@star{\ocotsstring{definition}}{definition}{#1}{#2}{#3}{def:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{proposition*}{O{} g g}
  {\ocots@result@beginbox@star{\ocotsstring{proposition}}{proposition}{#1}{#2}{#3}{prop:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{corollary*}{O{} g g}
  {\ocots@result@beginbox@star{\ocotsstring{corollary}}{corollary}{#1}{#2}{#3}{cor:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{conjecture*}{O{} g g}
  {\ocots@result@beginbox@star{\ocotsstring{conjecture}}{conjecture}{#1}{#2}{#3}{conj:}}
  {\ocots@result@endbox}

% ---------------------------------------------------------------------------
% Style des environnements de type theoreme classique
%
% Intitule en gras, numero, note entre parentheses, texte sur la meme ligne.
\newtheoremstyle{ocots}%
  {}{}{}{}{}{.}{ }%
  {\noindent\textbf{\upshape\thmname{#1}\thmnumber{~#2}}\thmnote{\normalfont~(#3)}}
\theoremstyle{ocots}

% Le lemme et le theoreme cite sont des resultats : ils partagent le compteur
% des boites a titre. Exemples et remarques ont chacun le leur (voir plus haut).
\newtheorem{ocots@lemma}[theorem]{\ocotsstring{lemma}}
\newtheorem*{ocots@lemma*}{\ocotsstring{lemma}}
\newtheorem{ocots@example}[example]{\ocotsstring{example}}
\newtheorem*{ocots@example*}{\ocotsstring{example}}
\newtheorem{ocots@remark}[remark]{\ocotsstring{remark}}
\newtheorem*{ocots@remark*}{\ocotsstring{remark}}
\newtheorem{citedtheorem}[theorem]{\ocotsstring{cited-theorem}}
\newtheorem*{citedtheorem*}{\ocotsstring{cited-theorem}}
\newtheorem{hypothesis}{\ocotsstring{hypothesis}}
\renewcommand{\thehypothesis}{H\arabic{hypothesis}}

% `\begin{env}[]' (crochets vides) bascule inconditionnellement amsthm dans sa
% forme « avec note », qui imprime une parenthese vide : `Exemple 2.1.2 ().'
% sur tout emploi nu, l'usage le plus frequent du corpus. On ne pose donc les
% crochets que s'il y a effectivement un titre ou une note a y mettre.
%
% Le style « ocots' (ci-dessus) enveloppe deja son 3e argument dans des
% parentheses : si on y glisse nous-memes `~(note)', ca en fait deux paires
% - `Exemple ( (note)).' Le titre seul reste donc nu (amsthm pose l'unique
% paire), et la note ne prend sa propre parenthese interieure que si elle
% accompagne un titre, pour rester distinguable de lui.
\newif\ifocots@result@hasnote
\newcommand{\ocots@result@classical}[2]{%
  \ocots@result@parseopt{#2}%
  \ocots@result@hasnotefalse
  \ifx\ocots@result@title\@empty\else\ocots@result@hasnotetrue\fi
  \ifx\ocots@result@note\@empty\else\ocots@result@hasnotetrue\fi
  \ifocots@result@hasnote
    \begin{#1}[\ifx\ocots@result@title\@empty
        \ocots@result@note
      \else
        \ocots@result@title
        \ifx\ocots@result@note\@empty\else~(\ocots@result@note)\fi
      \fi]%
  \else
    \begin{#1}%
  \fi
  \ifx\ocots@result@label\@empty\else
    \label{\ocots@result@label}%
  \fi}

\newenvironment{lemma}[1][]
  {\ocots@result@classical{ocots@lemma}{#1}}
  {\end{ocots@lemma}}
\newenvironment{lemma*}[1][]
  {\ocots@result@classical{ocots@lemma*}{#1}}
  {\end{ocots@lemma*}}

\newenvironment{example}[1][]
  {\ocots@result@classical{ocots@example}{#1}\pushQED{\QEDB}}
  {\popQED\endtrivlist\@endpefalse\end{ocots@example}}
\newenvironment{example*}[1][]
  {\ocots@result@classical{ocots@example*}{#1}\pushQED{\QEDB}}
  {\popQED\endtrivlist\@endpefalse\end{ocots@example*}}

\newenvironment{remark}[1][]
  {\ocots@result@classical{ocots@remark}{#1}}
  {\end{ocots@remark}}
\newenvironment{remark*}[1][]
  {\ocots@result@classical{ocots@remark*}{#1}}
  {\end{ocots@remark*}}
\tcolorboxenvironment{remark}{\ocotsboxstyle{remark}}
\tcolorboxenvironment{remark*}{\ocotsboxstyle{remark}}

% ---------------------------------------------------------------------------
% Introduction de chapitre : texte compose en retrait, rendu du theme
\newenvironment{chapterintro}
  {\begin{tcolorbox}[\ocotsboxstyle{chapterintro}]}
  {\end{tcolorbox}}

% ---------------------------------------------------------------------------
% Blocs etiquetes H1, Q1, D1
%
% La v0 ecrivait trois fois le meme code (compteur + \tag + regtotcounter). Ici
% une seule macro les fabrique : ajouter une famille tient en une ligne.
%
%   \ocots@taggedenv{nom}{prefixe affiche}{style de boite}
% La variante etoilee ne porte ni intitule ni numero : un \newtheorem* de
% style « ocots » composerait un « . » solitaire avant le texte (nom et numero
% vides, mais la ponctuation reste). C'est donc un environnement nu ; l'habillage
% (filet lateral) vient de \tcolorboxenvironment comme pour la version numerotee.
\newcommand{\ocots@taggedenv}[3]{%
  \newtheorem{#1}{}%
  \@namedef{the#1}{#2\arabic{#1}}%
  \tcolorboxenvironment{#1}{\ocotsboxstyle{#3}}%
  \newenvironment{#1*}{\par\noindent\ignorespaces}{\par}%
  \tcolorboxenvironment{#1*}{\ocotsboxstyle{#3}}}

\ocots@taggedenv{assumption}{H}{assumption}
\ocots@taggedenv{openquestion}{Q}{openquestion}
\ocots@taggedenv{difficulty}{D}{difficulty}

% ---------------------------------------------------------------------------
% Renvoi vers une ressource en ligne
\newenvironment{web}[1][]
  {\par\addvspace{\ocotsboxbeforeskip}%
   \noindent{\color{\ocotscolor{link}}\faExternalLink}~\textit{#1}\par\nobreak}
  {\par\addvspace{\ocotsboxafterskip}}

% ---------------------------------------------------------------------------
% Preuves
%
% Marqueur triangulaire en tete, carre noir en fin, retrait et couleur donnes
% par le theme.
\newenvironment{proof}[1][\ocotsproofname]
  {\par\pushQED{{\color{\ocotscolor{proof}}\ocotsproofqed}}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax
   \trivlist\item[\hskip\labelsep\itshape#1\@addpunct{}]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}
\tcolorboxenvironment{proof}{\ocotsboxstyle{proof}}

% Preuve etalee sur plusieurs diapositives : debut, milieu, fin. Seule la fin
% pose le carre final.
\newenvironment{proofbegin}[1][{\color{\ocotscolor{proof}}$\RHD$}]
  {\par\pushQED{{\color{\ocotscolor{proof}}\ocotsproofqed}}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax
   \trivlist\item[\hskip\labelsep\itshape#1\@addpunct{}]\ignorespaces}
  {\endtrivlist\@endpefalse}
\newenvironment{proofmiddle}[1][]
  {\par\pushQED{{\color{\ocotscolor{proof}}\ocotsproofqed}}\normalsize\normalfont}
  {\endtrivlist\@endpefalse}
\newenvironment{proofend}[1][]
  {\par\pushQED{{\color{\ocotscolor{proof}}\ocotsproofqed}}\normalsize\normalfont}
  {\popQED\endtrivlist\@endpefalse}
\tcolorboxenvironment{proofbegin}{\ocotsboxstyle{proof}}
\tcolorboxenvironment{proofmiddle}{\ocotsboxstyle{proof}}
\tcolorboxenvironment{proofend}{\ocotsboxstyle{proof}}

% ---------------------------------------------------------------------------
% Numerotation des problemes : (P_1), (P_2)...
% Le compteur est prefixe « ocots@ » : beamer cree \c@problem au \documentclass
% sur ses versions recentes, et \ocotsfreeenvs ne libere que les noms
% d'environnements — un \newcounter{problem} mourrait donc en diapositives.
\newcounter{ocots@problem}
\regtotcounter{ocots@problem}
\newcommand{\problemtag}[1][]{\addtocounter{ocots@problem}{1}\tag{P$_\theocots@problem$#1}}

% ---------------------------------------------------------------------------
% Blocs de texte annexes
\newcommand{\supplement}[1]{%
  \noindent{\color{\ocotscolor{emph-c}}\itshape\ocotsstring{supplement}~: #1}}
\newcommand{\reminder}[1]{%
  \noindent{\color{\ocotscolor{emph-b}}\itshape\ocotsstring{reminder}~: #1}}

% ---------------------------------------------------------------------------
% Divers
\newenvironment{todolist}{}{}

\newenvironment{vcenterpage}
  {\newpage\vspace*{\fill}\thispagestyle{empty}\renewcommand{\headrulewidth}{0pt}}
  {\vspace*{\fill}}

% Les intitules de renvoi sont ceux de la table des chaines, pas ceux que
% cleveref deduit tout seul : la deduction a lieu au chargement du paquet,
% avant que la langue ne soit fixee.
%
% Ce sont des DEFAUTS : un \crefname pose par le document dans son preambule
% gagne. Sans le garde \@ifundefined, ce crochet -- enregistre au chargement
% de `ocots', donc avant que le document n'ait rien pu dire -- s'executerait
% au \begin{document} et ecraserait le choix du document. Le cas concret est
% `citedtheorem' : la boite s'intitule « Theoreme (cite) », mais un article
% veut y renvoyer par « d'apres le Theoreme 2.8 ». Le document ne peut pas
% simplement poser son \crefname plus tard : cleveref fige ses formats dans
% son propre \AtBeginDocument, et tout \crefname execute apres est ignore en
% silence. D'ou l'inversion : c'est au template de ceder.
\newcommand{\ocots@result@crefname}[2]{%
  \@ifundefined{cref@#1@name}{%
    \crefname{#1}{\ocotsstring{#2}}{\ocotsstring{#2-plural}}}{}%
  \@ifundefined{Cref@#1@name}{%
    \Crefname{#1}{\ocotsstring{#2}}{\ocotsstring{#2-plural}}}{}}

\AtBeginDocument{%
  \@ifpackageloaded{cleveref}{%
    \let\ocots@result@refstep\ocots@result@refstep@cref
    \ocots@result@crefname{theorem}{theorem}%
    \ocots@result@crefname{definition}{definition}%
    \ocots@result@crefname{proposition}{proposition}%
    \ocots@result@crefname{corollary}{corollary}%
    \ocots@result@crefname{conjecture}{conjecture}%
    \ocots@result@crefname{ocots@lemma}{lemma}%
    % Ces deux-la passent par \newtheorem, donc leur TYPE etait deja correct ;
    % seul leur intitule manquait, cleveref le deduisant au chargement du
    % paquet, avant que la langue ne soit fixee.
    \ocots@result@crefname{hypothesis}{hypothesis}%
    \ocots@result@crefname{citedtheorem}{cited-theorem}}{}%
}

% ---------------------------------------------------------------------------
% cleveref + babel-french : les etiquettes contiennent « : »
%
% babel-french rend « : » actif, pour poser l'espace fine insecable de la
% typographie francaise. Or les etiquettes du template en contiennent toutes
% une -- ce sont les prefixes que \ocots@result@beginbox ajoute lui-meme :
% def:, thm:, prop:, cor:. cleveref construit ses recherches par
% \csname r@<etiquette>@cref\endcsname, sans neutraliser les caracteres
% actifs : le « : » s'y developpe, et la compilation part en « Missing
% \endcsname inserted » -- 534 erreurs sur un document de quinze enonces,
% avec des renvois rendus « :admissible@cref ».
%
% Le defaut est du cote LECTURE seulement : le .aux est correct, les
% etiquettes y sont ecrites telles qu'attendues. C'est \cref qui ne les
% retrouve pas.
%
% babel prevoit exactement ce cas : sous \@safe@activestrue, un caractere
% actif se developpe en lui-meme. C'est ainsi que babel protege \ref, \label
% et \cite. cleveref, lui, n'est pas connu de babel, et sa propre
% redefinition de \label arrive apres celle de babel. On enveloppe donc ses
% commandes publiques.
%
% Le crochet est `begindocument/end' et non \AtBeginDocument : cleveref
% redefinit \cref, \Cref et les intervalles dans son PROPRE \AtBeginDocument
% quand hyperref est charge (pour y ajouter la variante etoilee). Un crochet
% pose au chargement de `ocots' passerait avant, et envelopperait des
% definitions aussitot ecrasees.
%
% Meme cause que 6c92c45 (`fix(slides): securise les labels avec
% babel-french'), autre chemin : la, c'etait \beamer@label ; ici, la lecture
% des etiquettes par cleveref hors beamer.
\newcommand{\ocots@cref@safe@i}[2]{%
  \begingroup\@safe@activestrue\@nameuse{ocots@cref@orig@#1}{#2}\endgroup}
\newcommand{\ocots@cref@safe@istar}[2]{%
  \begingroup\@safe@activestrue\@nameuse{ocots@cref@orig@#1}*{#2}\endgroup}
\newcommand{\ocots@cref@safe@ii}[3]{%
  \begingroup\@safe@activestrue\@nameuse{ocots@cref@orig@#1}{#2}{#3}\endgroup}
\newcommand{\ocots@cref@safe@iistar}[3]{%
  \begingroup\@safe@activestrue\@nameuse{ocots@cref@orig@#1}*{#2}{#3}\endgroup}

% #1 : arite, `i' ou `ii'. #2 : nom de la commande, sans contre-oblique.
% La variante etoilee est relayee telle quelle : \cref* supprime l'hyperlien,
% et l'avaler silencieusement serait une regression.
%
% \DeclareCommandCopy et non \let : \cref est une commande ROBUSTE, donc
% \cref se developpe en \protect\cref␣ et c'est \cref␣ qui porte le corps.
% Un \let ne copierait que l'enveloppe, qui pointerait ensuite vers la
% NOUVELLE definition -- recursion infinie, « TeX capacity exceeded
% [grouping levels=255] ». \DeclareCommandCopy copie les deux.
\newcommand{\ocots@cref@protect}[2]{%
  \@ifundefined{#2}{}{%
    \expandafter\DeclareCommandCopy
      \csname ocots@cref@orig@#2\expandafter\endcsname\csname #2\endcsname
    \expandafter\DeclareRobustCommand\csname #2\endcsname{%
      \@ifstar{\@nameuse{ocots@cref@safe@#1star}{#2}}%
              {\@nameuse{ocots@cref@safe@#1}{#2}}}}}

% \AddToHook et \DeclareCommandCopy : noyau LaTeX 2020+ / 2022+. Absents,
% on ne fait rien -- le defaut reste, mais rien ne casse.
\@ifundefined{AddToHook}{}{\@ifundefined{DeclareCommandCopy}{}{%
  \AddToHook{begindocument/end}{%
    \@ifpackageloaded{cleveref}{%
      % \@safe@activestrue n'existe que sous babel ; sans lui, rien a faire.
      % Avec babel mais sans raccourci actif (anglais), l'enveloppe est un
      % no-op : on peut donc la poser sans tester la langue.
      \@ifundefined{@safe@activestrue}{}{%
        \ocots@cref@protect{i}{cref}%
