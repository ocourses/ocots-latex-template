\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-env}[2026/09/03 v1.0 ocots -- environnements]
%
% L'API publique du template : theoremes, definitions, exemples, remarques,
% preuves, hypotheses.
%
% REGLE CENTRALE DE LA REFONTE
% Ces environnements sont definis UNE SEULE FOIS, quel que soit le support.
% Aucun \ifSLIDES, aucun test de theme : la forme vient de \ocotsboxstyle, les
% couleurs du registre, les intitules de \ocotsstring. C'est ce qui permet de
% coller un enonce de TD dans le polycopie sans le retoucher — impossible en
% v0, ou les memes noms avaient deux signatures incompatibles (defaut D2).
%
% Les retouches propres a un medium (remise a zero des compteurs entre les
% \pause de beamer, par exemple) sont enregistrees par carrier/, apres coup.

% ---------------------------------------------------------------------------
% Liberation des noms
%
% beamer definit deja theorem, definition, corollary, lemma, example, proof...
% On les remplace deliberement par les notres, identiques d'un support a
% l'autre. C'est ce que la v0 contournait en prefixant tout par « my ».
\ocotsfreeenvs{theorem,definition,proposition,corollary,conjecture,lemma,%
example,remark,proof,assumption,solution,exercise,question,fact,problem,%
corollaire,theoreme,definitions,examples}

% ---------------------------------------------------------------------------
% Marqueurs de preuve
\newcommand{\newstep}{\textasteriskcentered}
\newcommand*{\QEDA}{\hfill\ensuremath{\blacksquare}}
\newcommand*{\QEDB}{\hfill\ensuremath{\square}}

% ---------------------------------------------------------------------------
% Signature commune : titre, etiquette et note sont des clefs optionnelles.
%
% Les environnements de resultat partagent explicitement le compteur `theorem'.
% On n'utilise pas \newtcbtheorem ici : son dernier argument impose un prefixe
% de label et rend impossible une etiquette brute (par exemple `thm:cauchy').
\@ifundefined{c@theorem}{\newcounter{theorem}[section]}{\@addtoreset{theorem}{section}}
\renewcommand{\thetheorem}{\thesection.\arabic{theorem}}

\pgfkeys{/ocots/result/.is family,
  /ocots/result,
  title/.store in=\ocots@result@title,
  label/.store in=\ocots@result@label,
  note/.store in=\ocots@result@note}

\newcommand{\ocots@result@reset}{%
  \def\ocots@result@title{}%
  \def\ocots@result@label{}%
  \def\ocots@result@note{}}

% Lit l'argument optionnel commun : soit une liste `cle=valeur' (des qu'un `='
% apparait), soit un titre brut. Ce filet est ce qui permet a l'ancienne
% syntaxe a un seul argument (`\begin{example}[Titre]', ou encore
% `\begin{remark*}[Contre-exemple]', toujours presente dans le corpus, cf.
% td/td3/td3.tex) de continuer a fonctionner : sans lui, un titre brut sans
% `=' tombe dans pgfkeys et casse la compilation (« I do not know the key »).
\newcommand{\ocots@result@parseopt}[1]{%
  \ocots@result@reset
  \IfBlankTF{#1}{}{%
    \IfSubStr{#1}{=}{\pgfkeys{/ocots/result,#1}}{\def\ocots@result@title{#1}}}}

\newcommand{\ocots@result@beginbox}[6]{%
  \ocots@result@parseopt{#3}%
  \IfNoValueF{#4}{\def\ocots@result@title{#4}}
  % L'ancienne forme {titre}{etiquette} attend une etiquette SANS le prefixe
  % (que ce mecanisme ajoute) ; mais rien n'empeche un auteur de le taper quand
  % meme par habitude, ce qui donnait `thm:thm:cauchy' (defaut d'origine de ce
  % chantier). Idempotence : si le prefixe y est deja, on ne le rajoute pas.
  \IfNoValueF{#5}{\IfBlankTF{#5}{}{%
    \IfBeginWith{#5}{#6}
      {\def\ocots@result@label{#5}}%
      {\def\ocots@result@label{#6#5}}}}
  \refstepcounter{theorem}%
  \ifx\ocots@result@label\@empty\else
    \label{\ocots@result@label}%
  \fi
  \begin{tcolorbox}[
    \ocotsboxstyle{#2}, breakable, attach title to upper=~,
    title={#1~\thetheorem%
      \ifx\ocots@result@title\@empty\else~\ocots@result@title\fi
      \ifx\ocots@result@note\@empty\else~(\ocots@result@note)\fi}]}
\newcommand{\ocots@result@endbox}{\end{tcolorbox}}

\NewDocumentEnvironment{theorem}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{theorem}}{theorem}{#1}{#2}{#3}{thm:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{definition}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{definition}}{definition}{#1}{#2}{#3}{def:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{proposition}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{proposition}}{proposition}{#1}{#2}{#3}{prop:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{corollary}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{corollary}}{corollary}{#1}{#2}{#3}{cor:}}
  {\ocots@result@endbox}
\NewDocumentEnvironment{conjecture}{O{} g g}
  {\ocots@result@beginbox{\ocotsstring{conjecture}}{conjecture}{#1}{#2}{#3}{conj:}}
  {\ocots@result@endbox}

% ---------------------------------------------------------------------------
% Style des environnements de type theoreme classique
%
% Intitule en gras, numero, note entre parentheses, texte sur la meme ligne.
\newtheoremstyle{ocots}%
  {}{}{}{}{}{.}{ }%
  {\noindent\textbf{\thmname{#1}\thmnumber{~#2}}\thmnote{\normalfont~(#3)}}
\theoremstyle{ocots}

% Les trois familles classiques reutilisent le compteur des boites a titre.
\newtheorem{ocots@lemma}[theorem]{\ocotsstring{lemma}}
\newtheorem*{ocots@lemma*}{\ocotsstring{lemma}}
\newtheorem{ocots@example}[theorem]{\ocotsstring{example}}
\newtheorem*{ocots@example*}{\ocotsstring{example}}
\newtheorem{ocots@remark}[theorem]{\ocotsstring{remark}}
\newtheorem*{ocots@remark*}{\ocotsstring{remark}}

% `\begin{env}[]' (crochets vides) bascule inconditionnellement amsthm dans sa
% forme « avec note », qui imprime une parenthese vide : `Exemple 2.1.2 ().'
% sur tout emploi nu, l'usage le plus frequent du corpus. On ne pose donc les
% crochets que s'il y a effectivement un titre ou une note a y mettre.
%
% Le style « ocots' (ci-dessus) enveloppe deja son 3e argument dans des
% parentheses : si on y glisse nous-memes `~(note)', ca en fait deux paires
% - `Exemple ( (note)).' Le titre seul reste donc nu (amsthm pose l'unique
% paire), et la note ne prend sa propre parenthese interieure que si elle
% accompagne un titre, pour rester distinguable de lui.
\newif\ifocots@result@hasnote
\newcommand{\ocots@result@classical}[2]{%
  \ocots@result@parseopt{#2}%
  \ocots@result@hasnotefalse
  \ifx\ocots@result@title\@empty\else\ocots@result@hasnotetrue\fi
  \ifx\ocots@result@note\@empty\else\ocots@result@hasnotetrue\fi
  \ifocots@result@hasnote
    \begin{#1}[\ifx\ocots@result@title\@empty
        \ocots@result@note
      \else
        \ocots@result@title
        \ifx\ocots@result@note\@empty\else~(\ocots@result@note)\fi
      \fi]%
  \else
    \begin{#1}%
  \fi
  \ifx\ocots@result@label\@empty\else
    \label{\ocots@result@label}%
  \fi}

\newenvironment{lemma}[1][]
  {\ocots@result@classical{ocots@lemma}{#1}}
  {\end{ocots@lemma}}
\newenvironment{lemma*}[1][]
  {\ocots@result@classical{ocots@lemma*}{#1}}
  {\end{ocots@lemma*}}

\newenvironment{example}[1][]
  {\ocots@result@classical{ocots@example}{#1}\par\pushQED{\QEDB}}
  {\popQED\endtrivlist\@endpefalse\end{ocots@example}}
\newenvironment{example*}[1][]
  {\ocots@result@classical{ocots@example*}{#1}\par\pushQED{\QEDB}}
  {\popQED\endtrivlist\@endpefalse\end{ocots@example*}}

\newenvironment{remark}[1][]
  {\ocots@result@classical{ocots@remark}{#1}}
  {\end{ocots@remark}}
\newenvironment{remark*}[1][]
  {\ocots@result@classical{ocots@remark*}{#1}}
  {\end{ocots@remark*}}
\tcolorboxenvironment{remark}{\ocotsboxstyle{remark}}
\tcolorboxenvironment{remark*}{\ocotsboxstyle{remark}}

% ---------------------------------------------------------------------------
% Introduction de chapitre : texte compose en retrait, rendu du theme
\newenvironment{chapterintro}
  {\begin{tcolorbox}[\ocotsboxstyle{chapterintro}]}
  {\end{tcolorbox}}

% ---------------------------------------------------------------------------
% Blocs etiquetes H1, Q1, D1
%
% La v0 ecrivait trois fois le meme code (compteur + \tag + regtotcounter). Ici
% une seule macro les fabrique : ajouter une famille tient en une ligne.
%
%   \ocots@taggedenv{nom}{prefixe affiche}{style de boite}
% La variante etoilee ne porte ni intitule ni numero : un \newtheorem* de
% style « ocots » composerait un « . » solitaire avant le texte (nom et numero
% vides, mais la ponctuation reste). C'est donc un environnement nu ; l'habillage
% (filet lateral) vient de \tcolorboxenvironment comme pour la version numerotee.
\newcommand{\ocots@taggedenv}[3]{%
  \newtheorem{#1}{}%
  \@namedef{the#1}{#2\arabic{#1}}%
  \tcolorboxenvironment{#1}{\ocotsboxstyle{#3}}%
  \newenvironment{#1*}{\par\noindent\ignorespaces}{\par}%
  \tcolorboxenvironment{#1*}{\ocotsboxstyle{#3}}}

\ocots@taggedenv{assumption}{H}{assumption}
\ocots@taggedenv{openquestion}{Q}{openquestion}
\ocots@taggedenv{difficulty}{D}{difficulty}

% ---------------------------------------------------------------------------
% Renvoi vers une ressource en ligne
\newenvironment{web}[1][]
  {\par\addvspace{\ocotsboxbeforeskip}%
   \noindent{\color{\ocotscolor{link}}\faExternalLink}~\textit{#1}\par\nobreak}
  {\par\addvspace{\ocotsboxafterskip}}

% ---------------------------------------------------------------------------
% Preuves
%
% Marqueur triangulaire en tete, carre noir en fin, retrait et couleur donnes
% par le theme.
\newenvironment{proof}[1][{\color{\ocotscolor{proof}}$\RHD$}]
  {\par\pushQED{{\color{\ocotscolor{proof}}\QEDA}}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax
   \trivlist\item[\hskip\labelsep\itshape#1\@addpunct{}]\ignorespaces}
  {\popQED\endtrivlist\@endpefalse}
\tcolorboxenvironment{proof}{\ocotsboxstyle{proof}}

% Preuve etalee sur plusieurs diapositives : debut, milieu, fin. Seule la fin
% pose le carre final.
\newenvironment{proofbegin}[1][{\color{\ocotscolor{proof}}$\RHD$}]
  {\par\pushQED{{\color{\ocotscolor{proof}}\QEDA}}%
   \normalsize\normalfont\topsep6\p@\@plus6\p@\relax
   \trivlist\item[\hskip\labelsep\itshape#1\@addpunct{}]\ignorespaces}
  {\endtrivlist\@endpefalse}
\newenvironment{proofmiddle}[1][]
  {\par\pushQED{{\color{\ocotscolor{proof}}\QEDA}}\normalsize\normalfont}
  {\endtrivlist\@endpefalse}
\newenvironment{proofend}[1][]
  {\par\pushQED{{\color{\ocotscolor{proof}}\QEDA}}\normalsize\normalfont}
  {\popQED\endtrivlist\@endpefalse}
\tcolorboxenvironment{proofbegin}{\ocotsboxstyle{proof}}
\tcolorboxenvironment{proofmiddle}{\ocotsboxstyle{proof}}
\tcolorboxenvironment{proofend}{\ocotsboxstyle{proof}}

% ---------------------------------------------------------------------------
% Numerotation des problemes : (P_1), (P_2)...
\newcounter{problem}
\regtotcounter{problem}
\newcommand{\tagProblem}[1][]{\addtocounter{problem}{1}\tag{P$_\theproblem$#1}}

% ---------------------------------------------------------------------------
% Blocs de texte annexes
\newcommand{\supplement}[1]{%
  \noindent{\color{\ocotscolor{emph-c}}\itshape\ocotsstring{supplement}~: #1}}
\newcommand{\reminder}[1]{%
  \noindent{\color{\ocotscolor{emph-b}}\itshape\ocotsstring{reminder}~: #1}}

% ---------------------------------------------------------------------------
% Divers
\newenvironment{todolist}{}{}

\newenvironment{vcenterpage}
  {\newpage\vspace*{\fill}\thispagestyle{empty}\renewcommand{\headrulewidth}{0pt}}
  {\vspace*{\fill}}

\endinput
