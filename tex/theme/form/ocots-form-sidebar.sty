\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-form-sidebar}[2026/09/06 v1.0 ocots -- forme : filet lateral]
%
% Pas de cadre : un filet lateral epais, un fond tres pale, des angles vifs. Le
% titre prend la couleur de la famille. C'est le rendu du theme charter (ex-v2).
% Moins de traits, plus de calme ; les familles restent distinguables d'un coup
% d'oeil par la couleur du filet et du titre.

\newcommand{\ocots@form@sidebar}[1]{%
  \ocots@derivecolor{back-#1}{ocots@key-#1!5!white}%
  \ocots@derivecolor{frame-#1}{ocots@key-#1}%   sert de couleur au filet
  \ocots@derivecolor{title-#1}{ocots@key-#1}%
  \ocotssetboxstyle{#1}{%
    enhanced jigsaw, breakable, sharp corners,
    boxrule=0pt, frame hidden,
    left=4mm, right=3mm, top=2.5mm, bottom=2.5mm,
    fonttitle=\bfseries\ocotsboxtitlefont,
    attach title to upper=~, separator sign dash,
    before skip=\ocotsboxbeforeskip, after skip=\ocotsboxafterskip,
    colback=\ocotscolor{back-#1},
    coltitle=\ocotscolor{title-#1},
    borderline west={2.5pt}{0pt}{\ocotscolor{frame-#1}}}}
\ocotsregisterform{sidebar}{\ocots@form@sidebar}

\endinput
