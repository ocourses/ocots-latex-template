\RequirePackage{ocots-theme-base}
\ocotsformall{plain}
\newcommand{\ocots@paperstatement}[1]{%
  \ocotssetboxstyle{#1}{enhanced jigsaw, breakable, blanker,
    left=0pt, right=0pt, top=0pt, bottom=0pt,
    fonttitle=\bfseries\upshape, fontupper=\itshape,
    attach title to upper={.\quad},
    before skip=\ocotsboxbeforeskip, after skip=\ocotsboxafterskip}}
\ocots@paperstatement{theorem}
\ocots@paperstatement{proposition}
\ocots@paperstatement{corollary}
\ocots@paperstatement{conjecture}
\ocotssiderule{remark}{none}
\ocotssiderule{assumption}{none}
\ocotssetboxstyle{lemma}{enhanced jigsaw, breakable, blanker,
  left=0pt, right=0pt, before skip=\ocotsboxbeforeskip,
  after skip=\ocotsboxafterskip, fontupper=\itshape}
\ocotsusetitles{plain}
\ocotsusemathbox{none}
\ocotsuselisting{lines}
\renewcommand{\ocotsproofname}{\ocotsstring{proof}}
\renewcommand{\ocotsproofqed}{\QEDB}
\ocotssetboxstyle{proof}{blanker, breakable, left=0pt, right=0pt,
  before skip=\ocotsboxbeforeskip, after skip=\ocotsboxafterskip,
  coltext=\ocotscolor{proof}}

