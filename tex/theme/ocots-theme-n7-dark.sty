\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-theme-n7-dark}[2026/09/03 v1.0 ocots -- theme N7 « retro », soutenu]
%
% Theme par defaut des diapositives. Reproduit la palette « Retro N7 » de la
% v0 : cadres pleins, titres blancs, teintes sourdes qui passent bien au
% videoprojecteur.

% ---------------------------------------------------------------------------
% Palette
\definecolor{ocots@raw@blue}  {rgb}{0.10,0.10,0.60}
\definecolor{ocots@raw@red}   {rgb}{0.60,0.10,0.10}
\definecolor{ocots@raw@green} {rgb}{0.00,0.40,0.00}
\definecolor{ocots@raw@proof} {rgb}{0.00,0.30,0.00}
\definecolor{ocots@raw@grey}  {rgb}{0.85,0.85,0.85}
\definecolor{ocots@raw@link}  {RGB}{213,138,39}
\definecolor{ocots@raw@cite}  {rgb}{0.60,0.04,0.04}
\definecolor{ocots@raw@pink}  {rgb}{0.55,0.05,0.35}

% Les cinq couleurs d'en-tete de diapositive, a alterner par theme aborde.
\definecolor{ocots@raw@s0}{rgb}{0.2,0.6,0.6}
\definecolor{ocots@raw@s1}{rgb}{0.5,0.3,0.0}
\definecolor{ocots@raw@s2}{rgb}{0.3,0.3,0.0}
\definecolor{ocots@raw@s3}{rgb}{0.5,0.0,0.0}
\definecolor{ocots@raw@s4}{rgb}{0.0,0.2,0.4}
\definecolor{ocots@raw@stitle}{rgb}{0.2,0.4,0.5}

\ocotssetcolor{emph-a}{ocots@raw@blue}
\ocotssetcolor{emph-b}{ocots@raw@red}
\ocotssetcolor{emph-c}{ocots@raw@green}
\ocotssetcolor{emph-d}{ocots@raw@link}
\ocotssetcolor{grey}{ocots@raw@grey}

\ocotssetcolor{link}{ocots@raw@link}
\ocotssetcolor{cite}{ocots@raw@cite}
\ocotssetcolor{url}{ocots@raw@pink}

\ocotssetcolor{proof}{ocots@raw@proof}

\ocotssetcolor{chapter}{black}
\ocotssetcolor{section}{black}
\ocotssetcolor{subsection}{black}
\ocotssetcolor{subsubsection}{black}

% Boites a titre : cadre plein, titre blanc. C'est la difference visible avec
% le theme papier, ou les cadres sont pastel et les titres noirs.
\ocotssetcolor{back-definition}{white}
\ocotssetcolor{frame-definition}{ocots@raw@blue!90!white}
\ocotssetcolor{title-definition}{white}

\ocotssetcolor{back-theorem}{white}
\ocotssetcolor{frame-theorem}{ocots@raw@red!90!white}
\ocotssetcolor{title-theorem}{white}

\ocotssetcolor{back-proposition}{white}
\ocotssetcolor{frame-proposition}{ocots@raw@green!90!white}
\ocotssetcolor{title-proposition}{white}

\ocotssetcolor{back-corollary}{white}
\ocotssetcolor{frame-corollary}{ocots@raw@green!90!white}
\ocotssetcolor{title-corollary}{white}

\ocotssetcolor{back-conjecture}{white}
\ocotssetcolor{frame-conjecture}{ocots@raw@green!90!white}
\ocotssetcolor{title-conjecture}{white}

\ocotssetcolor{back-exercise}{white}
\ocotssetcolor{frame-exercise}{ocots@raw@green!90!white}
\ocotssetcolor{title-exercise}{white}

\ocotssetcolor{back-solution}{white}
\ocotssetcolor{frame-solution}{ocots@raw@red!90!white}
\ocotssetcolor{title-solution}{white}

\ocotssetcolor{rule-remark}{ocots@raw@red}
\ocotssetcolor{rule-assumption}{black}

\ocotssetcolor{mathhighlight}{yellow!25!white}

\ocotssetcolor{slide0}{ocots@raw@s0}
\ocotssetcolor{slide1}{ocots@raw@s1}
\ocotssetcolor{slide2}{ocots@raw@s2}
\ocotssetcolor{slide3}{ocots@raw@s3}
\ocotssetcolor{slide4}{ocots@raw@s4}
\ocotssetcolor{slidetitle}{ocots@raw@stitle}
\ocotssetcolor{titlebox-back}{ocots@raw@stitle}
\ocotssetcolor{titlebox-frame}{black}
\ocotssetcolor{titlebox-text}{white}

% ---------------------------------------------------------------------------
% Formes
\RequirePackage{ocots-theme-base}

\endinput
