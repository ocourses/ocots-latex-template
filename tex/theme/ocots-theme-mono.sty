\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-theme-mono}[2026/09/06 v1.0 ocots -- theme noir et blanc]
%
% Pour l'impression sans couleur, et pour verifier qu'un document reste lisible
% en niveaux de gris (ex-« bw »). Les familles restent distinguables par le
% contraste : cadre clair pour les definitions, cadre sombre a titre blanc pour
% les theoremes.
%
% Ici la palette pose directement les triplets back-/frame-/title- : ils sont
% donc verrouilles, et la forme framed les utilise tels quels sans rien deriver.

\definecolor{ocots@raw@grey}  {rgb}{0.85,0.85,0.85}
\definecolor{ocots@raw@stitle}{rgb}{0.95,0.95,0.95}

\ocotssetcolor{emph-a}{black}
\ocotssetcolor{emph-b}{black}
\ocotssetcolor{emph-c}{black}
\ocotssetcolor{emph-d}{black}
\ocotssetcolor{grey}{ocots@raw@grey}

\ocotssetcolor{link}{black}
\ocotssetcolor{cite}{black}
\ocotssetcolor{url}{black}

\ocotssetcolor{proof}{black}
\ocotssetcolor{chapter}{black}
\ocotssetcolor{section}{black}
\ocotssetcolor{subsection}{black}
\ocotssetcolor{subsubsection}{black}

\ocotssetcolor{back-definition}{white}
\ocotssetcolor{frame-definition}{ocots@raw@grey!60!white}
\ocotssetcolor{title-definition}{black}

\ocotssetcolor{back-theorem}{white}
\ocotssetcolor{frame-theorem}{ocots@raw@grey!40!black}
\ocotssetcolor{title-theorem}{white}

\ocotssetcolor{back-proposition}{white}
\ocotssetcolor{frame-proposition}{ocots@raw@grey!65!black}
\ocotssetcolor{title-proposition}{white}

\ocotssetcolor{back-corollary}{white}
\ocotssetcolor{frame-corollary}{ocots@raw@grey!65!black}
\ocotssetcolor{title-corollary}{white}

\ocotssetcolor{back-conjecture}{white}
\ocotssetcolor{frame-conjecture}{ocots@raw@grey!65!black}
\ocotssetcolor{title-conjecture}{white}

\ocotssetcolor{back-exercise}{white}
\ocotssetcolor{frame-exercise}{ocots@raw@grey!60!white}
\ocotssetcolor{title-exercise}{black}

\ocotssetcolor{back-solution}{white}
\ocotssetcolor{frame-solution}{ocots@raw@grey!40!black}
\ocotssetcolor{title-solution}{white}

\ocotssetcolor{rule-remark}{black}
\ocotssetcolor{rule-assumption}{black}

\ocotssetcolor{mathhighlight}{ocots@raw@grey!50!white}

\ocotssetcolor{slide0}{black}
\ocotssetcolor{slide1}{black}
\ocotssetcolor{slide2}{black}
\ocotssetcolor{slide3}{black}
\ocotssetcolor{slide4}{black}
\ocotssetcolor{slidetitle}{black}
\ocotssetcolor{titlebox-back}{ocots@raw@stitle}
\ocotssetcolor{titlebox-frame}{ocots@raw@stitle!80!black}
\ocotssetcolor{titlebox-text}{black}

\RequirePackage{ocots-theme-base}

\endinput
