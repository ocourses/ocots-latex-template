\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-theme-base}[2026/09/06 v2.0 ocots -- socle commun aux themes]
%
% Socle « batteries incluses ». Il ne choisit AUCUNE couleur : il assemble un
% jeu de presets par defaut (formes, filets, titres, encadre de formule) et
% quelques styles qui n'ont pas de variante (preuve, bandeau de titre).
%
% Un theme minimal se resume donc a :
%     ... palette (une couleur cle par famille + couleurs semantiques) ...
%     \RequirePackage{ocots-theme-base}
% et rien d'autre. Voir ocots-theme-classic.sty.
%
% Un theme qui veut un autre rendu charge quand meme ce socle, puis surcharge
% ce qu'il veut APRES : \ocotsformall{sidebar}, \ocotsusetitles{bignum}...
% (voir ocots-theme-charter.sty). Le contrat vis-a-vis de ocots-env.sty ne
% change pas : la couche env ne lit toujours que \ocotsboxstyle{<famille>}.
%
% ATTENTION a l'ordre : \ocotsformall derive back-/frame-/title-<famille> de
% key-<famille>. Le theme doit donc poser sa palette AVANT de charger ce socle.

% --- Familles a titre : cadre pastel de la couleur de la famille ----------
\ocotsformall{framed}

% --- Blocs a filet lateral ----------------------------------------------
\ocotssiderule{remark}{bar}
\ocotssiderule{assumption}{bar}
\ocotssiderule{openquestion}{none}
\ocotssiderule{difficulty}{none}

% --- Preuves : retrait plus faible, texte colore, pas de cadre ----------
\ocotssetboxstyle{proof}{%
  blanker, breakable, left=1.5em,
  before skip=\ocotsboxbeforeskip, after skip=\ocotsboxafterskip,
  coltext=\ocotscolor{proof}}

% --- Bandeau de page de titre (diapositives) ---------------------------
\ocotssetboxstyle{titlebox}{%
  colback=\ocotscolor{titlebox-back},
  colframe=\ocotscolor{titlebox-frame},
  coltext=\ocotscolor{titlebox-text}}

% --- Titres et encadre de formule ------------------------------------
\ocotsusetitles{rules}
\ocotsusemathbox{highlight}

\endinput
