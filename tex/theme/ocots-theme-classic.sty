\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-theme-classic}[2026/09/06 v1.0 ocots -- alias deprecie : classic -> legacy]
%
% `classic' a d'abord designe le rendu historique, puis on l'a renomme `legacy'
% quand `ocots' est devenu le defaut. Garde comme alias pour ne pas casser les
% documents qui ecrivaient deja `theme=classic'.
\PackageWarningNoLine{ocots}{Le theme `classic' est deprecie : utiliser `theme=legacy' (rendu historique) ou `theme=ocots' (defaut)}
\RequirePackage{ocots-theme-legacy}
\endinput
