\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-theme-n7-light}[2026/09/03 v1.0 ocots -- theme N7 clair]
%
% Variante claire pour les diapositives : memes couleurs d'en-tete que le theme
% « retro », mais cadres pastel et titres noirs, comme sur le papier. Reproduit
% l'option `light' de la v0.

% ---------------------------------------------------------------------------
% Palette
\definecolor{ocots@raw@blue}  {rgb}{0.06,0.06,0.60}
\definecolor{ocots@raw@red}   {rgb}{0.60,0.04,0.04}
\definecolor{ocots@raw@green} {rgb}{0.06,0.60,0.06}
\definecolor{ocots@raw@proof} {rgb}{0.00,0.30,0.00}
\definecolor{ocots@raw@grey}  {rgb}{0.85,0.85,0.85}
\definecolor{ocots@raw@link}  {RGB}{213,138,39}
\definecolor{ocots@raw@cite}  {rgb}{0.60,0.04,0.04}
\definecolor{ocots@raw@pink}  {rgb}{0.60,0.04,0.42}

\definecolor{ocots@raw@s0}{rgb}{0.2,0.6,0.6}
\definecolor{ocots@raw@s1}{rgb}{0.7,0.4,0.0}
\definecolor{ocots@raw@s2}{rgb}{0.5,0.5,0.0}
\definecolor{ocots@raw@s3}{rgb}{0.6,0.0,0.0}
\definecolor{ocots@raw@s4}{rgb}{0.0,0.2,0.6}
\definecolor{ocots@raw@stitle}{rgb}{0.2,0.4,0.6}

\ocotssetcolor{emph-a}{ocots@raw@blue}
\ocotssetcolor{emph-b}{ocots@raw@red}
\ocotssetcolor{emph-c}{ocots@raw@green}
\ocotssetcolor{emph-d}{ocots@raw@link}
\ocotssetcolor{grey}{ocots@raw@grey}

\ocotssetcolor{link}{ocots@raw@link}
