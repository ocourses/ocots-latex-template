\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots}[2026/09/03 v1.0 ocots -- point d'entree du template]
%
% Point d'entree unique du template. Un document charge ce paquet et rien
% d'autre :
%
%   \documentclass[11pt,twoside]{ocots-book}
%   \usepackage[lang=fr, theme=n7, solutions=end, math=analysis]{ocots}
%
% ou, pour des diapositives :
%
%   \documentclass[9pt,t]{beamer}
%   \usepackage[lang=fr, theme=n7-dark]{ocots}
%
% Le support est deduit de la classe : les classes ocots-*.cls le declarent,
% beamer est reconnu automatiquement. Aucun booleen \ifSLIDES a la v0.
%
% Toutes les options sont de la forme clef=valeur et se resolvent en un nom de
% fichier. Ajouter un theme, une langue ou un module de macros, c'est ajouter un
% fichier : le noyau n'a pas a etre modifie.

\RequirePackage{xkeyval}
\RequirePackage{ocots-kernel}

% ---------------------------------------------------------------------------
% Options
% ---------------------------------------------------------------------------

% lang=fr|en          -> lang/ocots-lang-<valeur>.def
\def\ocots@lang{fr}
\DeclareOptionX{lang}{\def\ocots@lang{#1}}

% theme=ocots|legacy|legacy-dark|legacy-light|mono|charter|slate
%   -> theme/ocots-theme-<valeur>.sty
% Vide par defaut : le defaut reel depend du support (voir plus bas).
% Anciens noms acceptes en alias deprecies : classic -> legacy,
% classic-dark -> legacy-dark, n7 -> legacy, bw -> mono, v2 -> charter...
\def\ocots@theme{}
\DeclareOptionX{theme}{\def\ocots@theme{#1}}

% Surcharges d'apparence, appliquees APRES le theme : elles rejouent les memes
% \ocotsformall / \ocotsusetitles / \ocotsusemathbox que le theme, pour
% comparer deux rendus sur un meme document sans editer de fichier de theme.
% Vides par defaut : le theme decide.
\def\ocots@boxform{}
\DeclareOptionX{boxform}{\def\ocots@boxform{#1}}
\def\ocots@titles{}
\DeclareOptionX{titles}{\def\ocots@titles{#1}}
\def\ocots@mathbox{}
\DeclareOptionX{mathbox}{\def\ocots@mathbox{#1}}
\def\ocots@listing{}
\DeclareOptionX{listing}{\def\ocots@listing{#1}}

% solutions=none|inline|end   (cf. ocots-exercise.sty)
%   none   : les corriges ne sont pas composes du tout
%   inline : le corrige suit immediatement l'enonce
%   end    : le corrige est reporte en fin de partie, avec renvois croises
\def\ocots@solutions{end}
\DeclareOptionX{solutions}{\def\ocots@solutions{#1}}

% math=base,analysis,control,measure  -> math/ocots-math-<valeur>.sty
% « base » est toujours charge, meme s'il n'est pas cite. Plusieurs valeurs :
% entourer d'accolades (math={analysis,control}), sinon \usepackage[...]
% coupe sur la virgule avant que la clef ne la voie (cf. institution ci-dessous).
\def\ocots@math{}
\DeclareOptionX{math}{\def\ocots@math{#1}}

% institution=n7|inp|insa|uftmp  -> logos de la page de titre et des en-tetes
% Plusieurs etablissements : entourer d'accolades,
% institution={n7,insa} et non institution=n7,insa — la virgule non protegee
% separe les options de \usepackage avant que xkeyval ne la voie : seule la
% premiere valeur atteint la clef, et rien ne previent (aucune erreur, aucun
% avertissement — juste un logo manquant sur la page de titre).
\def\ocots@institution{n7}
\DeclareOptionX{institution}{\def\ocots@institution{#1}}

% author=...  -> metadonnee pdfauthor (plus de nom en dur dans le noyau)
\def\ocots@author{}
\DeclareOptionX{author}{\def\ocots@author{#1}}

% draft  -> affiche les notes de travail : \notework, \noteinmargin, \worktodo
\newif\ifocots@draft \ocots@draftfalse
\DeclareOptionX{draft}{\ocots@drafttrue}
\DeclareOptionX{final}{\ocots@draftfalse}

% binding=<longueur>  -> decalage de reliure pour l'impression
\def\ocots@binding{0mm}
\DeclareOptionX{binding}{\def\ocots@binding{#1}}

\DeclareOptionX*{\PackageWarning{ocots}{Unknown option `\CurrentOption' ignored}}
\ProcessOptionsX\relax

% ---------------------------------------------------------------------------
% Chargement
% ---------------------------------------------------------------------------

\ocots@detectcarrier

% Defaut de theme dependant du support. C'est un defaut, pas un test : une fois
% le theme choisi, plus personne ne sait quel support est actif.
\ifx\ocots@theme\@empty
  \ocots@ifcarrier{slides}%
    {\def\ocots@theme{legacy-dark}}{\def\ocots@theme{ocots}}%
\fi

% Charge un composant, avec un message clair s'il n'existe pas.
\newcommand{\ocots@require}[3]{%
  \IfFileExists{#1#2.#3}%
    {\ifnum\pdfstrcmp{#3}{def}=\z@ \input{#1#2.#3}\else\RequirePackage{#1#2}\fi}%
    {\PackageError{ocots}{Unknown #1 value `#2' (file #1#2.#3 not found)}%
      {Check the corresponding package option.}}}

% 1. Paquets. Charge aussi la langue au bon moment (juste apres l'encodage).
\RequirePackage{ocots-packages}

% 2. Macros de texte et de dessin.
\RequirePackage{ocots-text}
\RequirePackage{ocots-graphics}

% 3. Macros mathematiques, a la carte. « base » d'abord et toujours.
\RequirePackage{ocots-math-base}
\ifx\ocots@math\@empty\else
  \@for\ocots@tempc:=\ocots@math\do{%
    \ifx\ocots@tempc\@empty\else
      \edef\ocots@tempd{\ocots@tempc}%
      \ifnum\pdfstrcmp{\ocots@tempd}{base}=\z@\else
        \expandafter\ocots@require\expandafter{\detokenize{ocots-math-}}{\ocots@tempd}{sty}%
      \fi
    \fi}%
\fi

% 4. Theme : couleurs, styles de boites, mise en forme des titres.
\expandafter\ocots@require\expandafter{\detokenize{ocots-theme-}}{\ocots@theme}{sty}

% 4 bis. Surcharges d'apparence (boxform=/titles=/mathbox=/listing=), une fois
% le theme charge : elles rejouent les memes crochets et gagnent sur le theme.
\ifx\ocots@boxform\@empty\else\ocotsformall{\ocots@boxform}\fi
\ifx\ocots@titles\@empty\else\ocotsusetitles{\ocots@titles}\fi
\ifx\ocots@mathbox\@empty\else\ocotsusemathbox{\ocots@mathbox}\fi
\ifx\ocots@listing\@empty\else\ocotsuselisting{\ocots@listing}\fi

% 5. Environnements. Definis une seule fois, contre les crochets du theme.
\RequirePackage{ocots-env}
\RequirePackage{ocots-exercise}

% 6. Support : structure, page de titre, en-tetes, retouches propres au medium.
\expandafter\ocots@require\expandafter{\detokenize{ocots-carrier-}}{\ocots@carrier}{sty}

% 7. Alias des noms v0, pour que les documents existants compilent sans retouche.
\RequirePackage{ocots-compat}

% ---------------------------------------------------------------------------
% Metadonnees PDF
% ---------------------------------------------------------------------------
% colorlinks=true est deja passe au chargement de hyperref (ocots-packages.sty)
% : c'est une option figee au chargement, la repasser ici ne fait rien (juste
% un avertissement). Les couleurs, elles, restent modifiables ici — c'est
% pour ca qu'on attend \AtBeginDocument, une fois le theme charge.
\AtBeginDocument{%
  \hypersetup{%
    bookmarksopen=true,
    pdfhighlight=/O,
    linkcolor=\ocotscolor{link},
    citecolor=\ocotscolor{cite},
    urlcolor=\ocotscolor{url}}%
  \ifx\ocots@author\@empty\else\hypersetup{pdfauthor={\ocots@author}}\fi}

\endinput
