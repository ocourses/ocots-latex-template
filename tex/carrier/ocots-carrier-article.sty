\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-carrier-article}[2026/09/03 v1.0 ocots -- socle TD et examen]
%
% Ce que les TD et les sujets d'examen ont en commun : geometrie, en-tetes
% porteurs des metadonnees, page de titre a logos.
%
% En v0, td.sty et exam.sty etaient deux copies quasi identiques de 190 lignes,
% qui redefinissaient chacune leurs propres theoremes — d'ou l'incompatibilite
% avec le polycopie (defaut D2). Ici les environnements viennent de
% ocots-env.sty comme partout ailleurs, et seul le habillage est local.

\RequirePackage{ocots-institution}
\RequirePackage{fancyhdr}
\RequirePackage{titlesec}

% ---------------------------------------------------------------------------
% Geometrie
\RequirePackage[a4paper,includeheadfoot,margin=2.54cm]{geometry}
\setlength{\headheight}{1.2cm}
\setlength{\parindent}{0pt}
\setlength{\parskip}{5pt}

% ---------------------------------------------------------------------------
% Metadonnees
%
%   \title{...}       \shorttitle{...}   titre long / titre des pages suivantes
%   \numero{...}      \date{...}         reference du document / annee
%   \discipline{...}  \promotion{...}    matiere / public
\newcommand{\ocots@shorttitle}{}
\newcommand{\ocots@numero}{}
\newcommand{\ocots@discipline}{}
\newcommand{\ocots@promotion}{}
\newcommand{\ocots@duration}{}
\newcommand{\ocots@documents}{}
\newcommand{\ocots@calculator}{}
\newcommand{\ocots@examnote}{}
% \ifocots@exam (ocots-exercise.sty) couvre aussi le TD -- il ne pilote que le
% rendu sobre des exercices. Les champs d'en-tete d'examen et leur composition
% automatique par \maketitle sont propres a la classe ocots-exam : un
% indicateur dedie evite qu'un TD qui finirait par appeler \examnote par
% erreur voie le bloc se composer tout seul.
\newif\ifocots@examdoc
\ifx\ocots@carrier\ocots@exam@carrier
  \ocots@examdoctrue
\else
  \ocots@examdocfalse
\fi
\newif\ifocots@hasexamdata
\newif\ifocots@hasduration
\newif\ifocots@hasdocuments
\newif\ifocots@hascalculator
\newif\ifocots@hasexamnote
\ocots@hasexamdatafalse
\ocots@hasdurationfalse
\ocots@hasdocumentsfalse
\ocots@hascalculatorfalse
\ocots@hasexamnotefalse
\newcommand{\shorttitle}[1]{\renewcommand{\ocots@shorttitle}{#1}}
\newcommand{\numero}[1]{\renewcommand{\ocots@numero}{#1}}
\newcommand{\discipline}[1]{\renewcommand{\ocots@discipline}{#1}}
\newcommand{\promotion}[1]{\renewcommand{\ocots@promotion}{#1}}
\newcommand{\duree}[1]{\renewcommand{\ocots@duration}{#1}\ocots@hasexamdatatrue\ocots@hasdurationtrue}
\newcommand{\documents}[1]{\renewcommand{\ocots@documents}{#1}\ocots@hasexamdatatrue\ocots@hasdocumentstrue}
\newcommand{\calculatrice}[1]{\renewcommand{\ocots@calculator}{#1}\ocots@hasexamdatatrue\ocots@hascalculatortrue}
\newcommand{\examnote}[1]{\renewcommand{\ocots@examnote}{#1}\ocots@hasexamdatatrue\ocots@hasexamnotetrue}

\newcommand{\printinstructions}{%
  \ifocots@hasexamdata
    \begin{instructions}\breakline%
      \begin{itemize}
        \ifocots@hasduration
          \item \textbf{\ocotsstring{duration}}~:~\ocots@duration
        \fi
        \ifocots@hasdocuments
          \item \textbf{\ocotsstring{documents}}~:~\ocots@documents
        \fi
        \ifocots@hascalculator
          \item \textbf{\ocotsstring{calculator}}~:~\ocots@calculator
        \fi
        \ifocots@hasexamnote
          \item \ocots@examnote
        \fi
      \end{itemize}
    \end{instructions}
  \fi}

% ---------------------------------------------------------------------------
% En-tetes et pieds
%
% Premiere page : logo a gauche, promotion et discipline au centre, date et
% reference a droite. Les pages suivantes gardent les versions courtes.
% `plain' est le style de la premiere page, pose par \maketitle ; c'est lui qui
% porte la version longue. Les pages suivantes utilisent `fancy' et sa version
% courte.
\pagestyle{fancy}
\fancyhf{}
\fancyhead[L]{\textsc{\small\ocots@discipline}}
\fancyhead[R]{{\small\textbf{\ocots@shorttitle}}}
\fancyfoot[C]{\textrm{\thepage}}

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyhead[L]{\ocotslogosheader[0.9cm]}%
  \fancyhead[C]{{\scriptsize\emph{\ocots@promotion}\\[-2pt]\textsc{\ocots@discipline}}}%
  \fancyhead[R]{{\scriptsize\@date\\[-2pt]\ocots@numero}}%
  \fancyfoot[C]{\textrm{\thepage}}}

% ---------------------------------------------------------------------------
% Titres de section : la mise en forme vient du theme (cf. carrier book).
\ocotsifheading{titles-article}{\ocotsheading{titles-article}}{}

% ---------------------------------------------------------------------------
% Titre du document
\renewcommand{\maketitle}{%
  \par
  \begin{center}
    {\LARGE\bfseries\@title\par}
  \end{center}%
  \thispagestyle{plain}%
  \addvspace{1.5em}%
  \ifocots@examdoc\printinstructions\fi}

% ---------------------------------------------------------------------------
% Consignes et parties
\newtheorem*{instruction}{\ocotsstring{instruction}}
\newtheorem*{instructions}{\ocotsstring{instructions}}
\newtheorem{ocots@docpart}{\ocotsstring{part}}
\newenvironment{docpart}[1][]
  {\ocots@startpart\begin{ocots@docpart}[#1]}
  {\end{ocots@docpart}}

\endinput
