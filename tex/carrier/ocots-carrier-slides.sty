\NeedsTeXFormat{LaTeX2e}
\ProvidesPackage{ocots-carrier-slides}[2026/09/03 v1.0 ocots -- support : diapositives]
%
% Support « diapositives », charge automatiquement quand la classe est beamer.
%
% Il fournit ce que les jeux de diapos de la v0 recopiaient a la main : la page
% de titre (28 lignes identiques au bit pres dans les cinq jeux) et la notion de
% chapitre (\setcounter{chapter}{5} + \def\chaptername{...} a chaque fois).
% C'est le defaut D7.

\RequirePackage{ocots-institution}

% ---------------------------------------------------------------------------
% Reglages beamer
\setbeamertemplate{navigation symbols}{}
\setbeamercolor{structure}{fg=\ocotscolor{slidetitle}}
\setbeamercolor{alerted text}{fg=\ocotscolor{emph-b}}
\setbeamercolor{section in toc}{fg=\ocotscolor{section}}
\setbeamercolor{subsection in toc}{fg=\ocotscolor{subsection}}

% Beamer charge hyperref avant ocots et desactive ensuite l'option colorlinks.
% On reconfigure uniquement les macros internes de couleur a la fin du preambule,
% apres les hooks de hyperref, sans repasser l'option qui provoquerait un warning.
\AddToHook{begindocument/end}{%
  \Hy@colorlinkstrue
  \def\@pdfborder{0 0 0}%
  \let\@pdfborderstyle\@empty
  \def\Hy@colorlink#1{%
    \begingroup
    \HyColor@UseColor#1}%
  \def\Hy@endcolorlink{\endgroup}}

\setbeamertemplate{theorems}[numbered]
\setbeamertemplate{caption}[numbered]
\setbeamersize{text margin left=3mm,text margin right=3mm}
\addtobeamertemplate{frametitle}{}{\vspace*{-5pt}}

% Titre d'environnement sur la meme ligne que le texte : sans cela, beamer
% ouvre un bloc et le rendu s'ecarte de celui du polycopie.
\setbeamertemplate{theorem begin}{%
  {\ifx\inserttheoremnumber\@empty
     \textcolor{black}{\bfseries\inserttheoremname}%
   \else
     \textcolor{black}{\bfseries\inserttheoremname\inserttheoremnumber}%
   \fi
   \ifx\inserttheoremaddition\@empty\else\space(\inserttheoremaddition)\fi
   \inserttheorempunctuation~}}
\setbeamertemplate{theorem end}{}

% Babel-french rend `:' actif. Le patch de beamer pour \label fait un \xdef
% de \@currentHref sans proteger les caracteres actifs : un label comme
% `prop:nom' devient alors une destination contenant l'espace francais. La
% protection doit entourer cette construction, et non desactiver la ponctuation
% francaise dans le document.
\def\beamer@label<#1>#2{%
  \alt<#1>{%
    \begingroup
      \@safe@activestrue
      \xdef\@currentHref{#2}%
      \@safe@activesfalse
    \endgroup
    \beamer@origlabel{#2}%
    \beamer@nameslide{#2}%
  }{\beamer@dummynameslide}}
\def\beamer@label@in@display<#1>#2{%
  \alt<#1>{%
    \begingroup
      \@safe@activestrue
      \xdef\@currentHref{#2}%
      \@safe@activesfalse
    \endgroup
    \beamer@origlabel@in@display{#2}%
  }{\beamer@dummynameslide}}

% La reference d'un label passe ensuite par une autre expansion dans hyperref.
% Babel protege deja \ref, mais pas le troisieme argument de \hyper@link@ ; on
% reprend sa construction sous le meme drapeau pour les liens \hyperref.
\patchcmd{\hyper@link@}
  {\edef\Hy@tempb{#3}}
  {\@safe@activestrue\edef\Hy@tempb{#3}\@safe@activesfalse}
  {}
  {\PackageWarning{ocots}{Impossible de proteger les labels actifs dans hyperref}}

% ---------------------------------------------------------------------------
% Chapitres
%
% beamer n'a pas de chapitre : on en fabrique un, et les sections s'y
% raccrochent. \thesection devient « chapitre.section ».
\newcounter{chapter}
\@addtoreset{section}{chapter}
\renewcommand\thechapter{\arabic{chapter}}
\renewcommand\thesection{\thechapter.\arabic{section}}

\setbeamertemplate{section in toc}{%
  \thechapter.\inserttocsectionnumber.~\inserttocsection}
\setbeamertemplate{subsection in toc}{%
  \hspace{1.9em}\thechapter.\inserttocsectionnumber.\inserttocsubsectionnumber.~%
  \inserttocsubsection\par}

% \slidechapter{5}{Equations differentielles lineaires}
% \def et non \newcommand : une macro \long ne serait jamais \ifx-egale a
% \@empty, et le test « y a-t-il un chapitre ? » serait toujours faux.
\def\ocots@chaptername{}
\newcommand{\slidechapter}[2]{%
  \setcounter{chapter}{#1}\def\ocots@chaptername{#2}}

% ---------------------------------------------------------------------------
% Compteur de diapositive : le numero cercle en haut a droite
\newcommand*{\ocots@counterfont}[1][ptm]{\fontfamily{#1}\selectfont}
\newcommand*{\slidecounter}[1][\ocotscolor{slidetitle}]{%
  \begin{tikzpicture}[inner sep=0pt, baseline=(base)]
    \def\ocots@thick{0.15em}%
    \def\ocots@radius{0.55em}%
    \coordinate (O) at (0em,0em);
    \coordinate[shift={(0em,\ocots@radius)}] (A) at (O);
    \draw[black] (O) node{%
      \scriptsize\bfseries\ocots@counterfont
      \textcolor{#1}{\insertframenumber}};
    \draw[\ocotscolor{grey},line width=\ocots@thick,rotate=90]
      (A) arc (0:360:\ocots@radius);
    \node (base) at (0,-.25ex) {};
  \end{tikzpicture}}

% ---------------------------------------------------------------------------
% La diapositive
%
%   \begin{slide}{Titre}          couleur d'en-tete courante
%   \begin{slide}[\ocotscolor{slide2}]{Titre}
%   \begin{slide}                  sans habillage de titre
%
% \slidecolor change la couleur pour toutes les suivantes : c'est ce qui permet
% de colorer un jeu de diapos par theme aborde.
\def\ocots@slidecolor{\ocotscolor{slidetitle}}
\newcommand{\slidecolor}[1]{\def\ocots@slidecolor{#1}}

\def\ocots@slidetitle#1{%
  \begin{minipage}{0.9\textwidth}
    \large\bfseries\color{\ocots@slidecolor}#1
  \end{minipage}\hfill
  \begin{minipage}{0.04\textwidth}
    \begin{flushright}\slidecounter[\ocots@slidecolor]\end{flushright}
  \end{minipage}
  \vspace{-2pt}
  {\color{\ocots@slidecolor}\noindent\rule{\textwidth}{0.1em}}%
  % Espace apres le filet de titre. \addvspace (et non \medskip/\bigskip) :
  % si le corps de la diapositive commence par une boite (definition,
  % example...), celle-ci pose elle-meme \addvspace{\ocotsboxbeforeskip}
  % avant elle (cf. ocots-env.sty) ; \addvspace prend le maximum des deux
  % appels au lieu de les cumuler, donc l'espacement reste identique que la
  % diapositive commence par du texte ou par une boite, sans qu'il soit
  % necessaire d'ajouter un \bigskip/\medskip manuel en tete de texte.
  \par\addvspace{\ocotsboxbeforeskip}}

\newenvironment{slide}[1][]
  {\ifx\relax#1\relax\else\def\ocots@slidecolor{#1}\fi
   \begin{frame}%
   \@ifnextchar\bgroup\ocots@slidetitle\relax}
  {\end{frame}}

% Boite de titre encadree. \slidetitlepage ne s'en sert plus (bandeau
% ci-dessous) ; elle reste definie pour les documents qui l'emploient.
\newtcolorbox{titlebox}{\ocotsboxstyle{titlebox}}

% ---------------------------------------------------------------------------
% Page de titre
%
% Utilise \title, \author, \date, l'option institution= et \slidechapter.
% Sous beamer, le titre et l'auteur se lisent avec \inserttitle et
% \insertauthor : \@title y declenche « No \title given ».
%
% La page est coupee en deux : un bandeau pleine largeur, sans cadre, colle
% au bord superieur (fond `titlebox-back', texte `titlebox-text'), puis
% auteur, date, logos et contenu optionnel centres dans ce qui reste. Les
% logos restent sur fond blanc : ils sont dessines pour lui.
%
% Tout est dessine dans le gabarit `background' de beamer, local a la
% diapositive : il est pose a l'origine de la page, sans les marges du texte,
% et ne demande pas de seconde compilation (contrairement a un overlay
% `remember picture'). Le bandeau grandit si le titre du chapitre est long.
%
% Le fond du bandeau deborde de la page (fond perdu) : pose exactement au
% bord, il laissait un liseré blanc d'environ 0,25 pt en haut et a gauche,
% visible a l'ecran selon le zoom. La page rogne ce qui depasse.
\def\ocots@titlebandheight{0.5\paperheight}
\def\ocots@titlebleed{2pt}

\def\ocots@titleband{%
  \ifx\ocots@chaptername\@empty
    {\LARGE\bfseries\inserttitle\par}%
  \else
    {\large\color{\ocotscolor{titlebox-text}!75!\ocotscolor{titlebox-back}}%
     \inserttitle\par}%
    \vspace{0.8em}%
    {\Large\bfseries\ocotsstring{chapter-label}~\thechapter\par}%
    \vspace{0.4em}%
    {\LARGE\ocots@chaptername\par}%
  \fi}

\def\ocots@titlepage{%
  \begin{tikzpicture}
    \useasboundingbox (0,0) rectangle (\the\paperwidth,\the\paperheight);
    \node[anchor=north west, inner xsep=0pt, inner ysep=1.5em,
          minimum width=\paperwidth, minimum height=\ocots@titlebandheight,
          text width=0.84\paperwidth, align=center,
          text=\ocotscolor{titlebox-text}]
      (ocots@band) at (0,\the\paperheight) {\ocots@titleband};
    \begin{scope}[on background layer]
      \fill[\ocotscolor{titlebox-back}]
        ([xshift=-\ocots@titlebleed]ocots@band.south west) rectangle
        ([xshift=\ocots@titlebleed, yshift=\ocots@titlebleed]ocots@band.north east);
    \end{scope}
    \node[anchor=center, text width=0.84\paperwidth, align=center]
      at ($(ocots@band.south)!0.5!(0.5\paperwidth,0)$) {%
        {\large\insertauthor\par}%
        \vspace{0.8em}\insertdate\par
        \vspace{1.6em}\ocotslogos[2.5em]%
        \ifx\ocots@titlepage@extra\@empty\else
          \par\vspace{1em}\ocots@titlepage@extra
        \fi};
  \end{tikzpicture}}

\newcommand{\slidetitlepage}[1][]{%
  \begingroup
    \IfBlankTF{#1}{\def\ocots@titlepage@extra{}}{\def\ocots@titlepage@extra{#1}}%
    \setbeamertemplate{background}{\ocots@titlepage}%
    \begin{frame}\end{frame}%
  \endgroup}

% ---------------------------------------------------------------------------
% Retouches propres au medium
%
% Sans cela les numeros de theoreme changent entre deux \pause d'une meme
% diapositive. C'est exactement le genre de correctif qui a sa place ici, et
% pas dans ocots-env.sty : le noyau n'a pas a savoir qu'il existe des overlays.
% Les noms sont ceux des compteurs REELLEMENT incrementes : `theorem' (le
% compteur des resultats n'est plus un compteur tcolorbox, tcb@cnt@theorem
% ne designait plus rien), `example', `remark', et ceux des exercices.
\resetcounteronoverlays{theorem}
\resetcounteronoverlays{example}
\resetcounteronoverlays{remark}
\resetcounteronoverlays{tcb@cnt@exercise}
\resetcounteronoverlays{ocots@exinner}
\resetcounteronoverlays{ocots@exouter}
\resetcounteronoverlays{assumption}
\resetcounteronoverlays{openquestion}
\resetcounteronoverlays{difficulty}
\resetcounteronoverlays{ocots@problem}

% ---------------------------------------------------------------------------
% Listes : un peu plus aerees qu'au fil du texte
\setlist{itemsep=0.25em}
\setitemize[1]{label={\small\textbullet}}
\setitemize[2]{label={\small -}}

\endinput
