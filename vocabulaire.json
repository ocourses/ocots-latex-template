{
  "schema": 1,
  "description": "Environnements publics du template, par famille, pour les outils (ocots-lint). Vérifié contre tex/ par .github/scripts/verifier-vocabulaire.",
  "familles": {
    "resultat": {
      "boite": true,
      "description": "énoncé mathématique : théorème, proposition, corollaire, lemme, conjecture, théorème cité"
    },
    "definition": {
      "boite": true,
      "description": "définition"
    },
    "hypothese": {
      "boite": true,
      "description": "hypothèse, dont le bloc étiqueté H1, H2…"
    },
    "encadre": {
      "boite": true,
      "description": "bloc étiqueté mis en avant : question ouverte (Q1…), difficulté (D1…)"
    },
    "exemple": {
      "boite": true,
      "description": "exemple"
    },
    "remarque": {
      "boite": true,
      "description": "remarque, aparté optionnel"
    },
    "exercice": {
      "boite": true,
      "description": "exercice (TD, examen, polycopié)"
    },
    "ressource": {
      "boite": false,
      "description": "renvoi vers une ressource en ligne"
    },
    "preuve": {
      "boite": false,
      "description": "preuve, ou preuve étalée sur plusieurs diapositives"
    },
    "question": {
      "boite": false,
      "description": "partie d'un exercice : question, sous-question, correction"
    },
    "consigne": {
      "boite": false,
      "description": "consignes d'un TD ou d'un examen"
    },
    "structure": {
      "boite": false,
      "description": "découpage ou mise en page : diapositive, partie, introduction de chapitre…"
    },
    "travail": {
      "boite": false,
      "description": "notes de travail, absentes de la version finale"
    }
  },
